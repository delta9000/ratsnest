{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "binaryDir": "build",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ci",
      "binaryDir": "build-ci",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "RATSNEST_WERROR": "ON"
      }
    },
    {
      "name": "san",
      "binaryDir": "build-san",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "RATSNEST_SAN": "ON"
      }
    }
  ]
}
