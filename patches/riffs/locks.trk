# locks.trk -- "Locks". 124 BPM, F# minor, 16 rows per bar, 72 bars.
# Every Surge param that changes per note is a tracker column: the bass's
# cutoff and resonance (cva, cvb), the pad's chord quality (Osc 2 and Osc 3
# pitch as cva, cvb: one Surge instance plays the whole chord), and the
# pluck's echo throw (cvd). Ghost hats, rims and shakers are chance hits
# and late hits, so no two bars are the same.
#
#   intro 8 | A 16 | B 16 | break 8 | C 16 | outro 8

track kick   note len 1          # 1
track clap   note vel len 1      # 2
track hat    note vel len 1      # 3
track ohat   note vel len 1      # 4
track rim    note vel len 1      # 5  7-row free layer
track shaker note vel len 1      # 6  10-row free layer
track pad    note vel cva cvb    # 7  Surge: root; cva = Osc 2 pitch, cvb = Osc 3 pitch
track bass   note vel cva cvb from pad   # 8  Surge: cva = cutoff lock, cvb = resonance lock
track pluck  note vel cvd from pad       # 9  Surge FM2: cvd = echo throw

# Osc pitch is +-7 semitones over 0..1: +3 = .714, +4 = .786, +5 = .857,
# +7 = 1, -5 = .143 (the fifth below: an inversion).
pattern chords 8x16 pad
1:00 | Fs3 .8 .714 1       # F#m
3:00 | D3  .75 .786 1      # D
5:00 | A3  .7 .786 .143    # A, fifth below
7:00 | E3  .8 .857 1       # Esus4
8:08 | ~E3 .8 .786         # ... to E (the slur keeps the chord ringing)

pattern chords_b 8x16 pad
1:00 | Fs3 .8 .714 .143    # F#m over its fifth
3:00 | D3  .75 .786 1
4:08 | x   .6 .857         # Dsus4 for half a bar
5:00 | A3  .7 .786 1
7:00 | E3  .8 .857 .143
7:12 | ~E3 .8 .786
8:08 | ~Cs3 .85 .714 1     # C#m: the turnaround leans back to F#

pattern bass_a 2x16 bass
00 | t1-24 .95 .34 .45
03 | t1-12 .6  .46
04 | t1-24 .8  .36
06 | ~t1-17 .7 .40
08 | t1-24 1   .52 .55
10 | t1-12 .55 .33
11 | ~t1-10 .7 .44
12 | off
13 | t1-24 .85 .38
14 | ~t1-12 .9 .50
16 | t1-24 .95 .34 .45
18 | t1-24 .5  .30
19 | t1-12 .75 .55 .62
20 | t1-24 .8  .36 .45
22 | t1-17 .7  .42
23 | ~t1-12 .8 .48
24 | t1-24 1   .58 .5
26 | t1-12 .55 .35
27 | t1-24 .7  .40
28 | off
29 | t1-17 .8  .45
30 | ~t1-12 .9 .55 .6
31 | ~t1-10 .7 .60

pattern bass_b 2x16 bass
00 | t1-24 1   .40 .5
01 | t1-24 .5  .32
02 | t1-12 .8  .55 .62
03 | ~t1-10 .6 .50
04 | t1-24 .7  .36 .45
05 | t1-12 .55 .44
06 | t1-24 .9  .62 .7
07 | off
08 | t1-17 .75 .38 .5
09 | ~t1-12 .8 .46
10 | t1-24 .6  .34
11 | t1-12 .9  .66 .72
12 | t1-24 .7  .36 .5
14 | t1-5  .8  .52
15 | ~t1-12 .7 .44
16 | t1-24 1   .40 .5
18 | t1-12 .8  .50
19 | t1-24 .55 .32
20 | t1-17 .85 .58 .65
21 | ~t1-12 .7 .48
22 | t1-24 .6  .34 .5
23 | t1-24 .9  .60
24 | t1-10 .8  .54 .62
25 | ~t1-12 .7 .46
26 | t1-24 .6  .36
27 | t1-12 1   .70 .75
28 | off
29 | t1-24 .7  .40 .5
30 | t1-17 .8  .50
31 | ~t1-12 .9 .62 .7

pattern pluck_a 2x16 pluck
00 | t1+12 .7 0
03 | t1+19 .45
06 | t1+14 .6
10 | t1+12 .5
11 | t1+7  .55 .9      # thrown into the echo
16 | t1+12 .6 0
19 | t1+19 .45
22 | t1+24 .7 .8
26 | t1+14 .5 0
29 | t1+7  .5

pattern pluck_b 2x16 pluck
00 | t1+12 .75 0
02 | t1+19 .4
03 | t1+24 .5
06 | t1+14 .65 .7
09 | t1+12 .5 0
10 | t1+7  .45
11 | t1+12 .6
14 | t1+26 .55 1
16 | t1+12 .7 0
18 | t1+19 .45
19 | t1+14 .5
22 | t1+24 .75 .8
24 | t1+19 .5 0
26 | t1+14 .55
27 | t1+12 .45
30 | t1+7  .6 .9

pattern kick 16 kick
lane kick x...x...x...x...

pattern clap 16 clap
04 | x .8
12 | x@.04 .85
15 | x?.3 .3

pattern roll 16 clap
00 | x .5
04 | x .6
08 | x*2 .5
10 | x*2 .6
12 | x*3 .75
14 | x*4 .9

# Closed hats: accents pushed a little late, ghosts by chance.
pattern hat 16 hat
00 | x .5
01 | x?.35 .18
02 | x@.06 .85
03 | x?.5 .25
04 | x .45
06 | x@.1 .9
07 | x?.4 .28
08 | x .5
10 | x@.06 .8
11 | x?.6 .22
12 | x .45
13 | x?.3 .2
14 | x@.12 .95
15 | x*2?.5 .3

pattern ohat 16 ohat
lane ohat ..6...7...6...8.

pattern rim 7 rim
00 | x .6
03 | x@.15 .4
05 | x?.5 .3

pattern shaker 10 shaker
00 | x .55
01 | x@.2 .25
02 | x .4
03 | x?.6 .2
04 | x .6
05 | x@.15 .3
06 | x?.7 .45
07 | x .2
08 | x@.1 .5
09 | x?.5 .25

section intro chords+hat+shaker~
section a     chords+bass_a+kick+hat+rim~+shaker~
section ap    chords+bass_a+kick+hat+rim~+shaker~+pluck_a
section b     chords_b+bass_b+kick+clap+hat+ohat+pluck_a+rim~+shaker~
section bf    chords_b+bass_b+kick+clap+hat+ohat+pluck_a+rim~+shaker~+roll@112
section brk   chords+bass_a+hat+pluck_b+shaker~+roll@112
section c     chords_b+bass_b+kick+clap+hat+ohat+pluck_b+rim~+shaker~
section out   chords+bass_a+kick+hat+rim~+shaker~

order intro a ap b bf brk c c out
