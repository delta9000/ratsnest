# ember — warm kosmische pad
# 240s generative ambient: 3 sympathetic strings ringing in sympathy with
# each other; bowed pink-noise pad swells; sub on D1; sparse sine events.
# Generated by humans, mistakes by claude.

# === METRONOME (drives stochastic events only) ===
clock = clock { bpm: 40 }
g6  = div { by: 6 }     # 9.0 s  — sympathetic-string strikes
g12 = div { by: 12 }    # 18.0 s — sparse sine events
clock -> g6.in          # without this the dividers never tick — no strikes
clock -> g12.in

# === GLACIAL LFOs (incommensurate periods) ===
l1 = lfo { freq: 0.011hz }     # 91 s
l2 = lfo { freq: 0.00613hz }   # 163 s
l3 = lfo { freq: 0.00405hz }   # 247 s
l4 = lfo { freq: 0.00256hz }   # 391 s

# === GENERATIVE PITCH REGISTER ===
q1 = quant { scale: [0, 3, 5, 7, 10] }
t1 = turing { len: 8, prob: 0.10, seed: 23 }
clock -> t1.clock
t1 -> q1.in

# === SYMPATHETIC STRINGS (D2 / A2 / D3 Karplus-Strong) ===
str_d2 = string { seed: 7, freq: 73.42hz, structure: 0.25,
                  brightness: 0.55, damping: 0.94, position: 0.30 }
str_a2 = string { seed: 11, freq: 110hz, structure: 0.25,
                  brightness: 0.5, damping: 0.96, position: 0.28 }
str_d3 = string { seed: 13, freq: 146.83hz, structure: 0.25,
                  brightness: 0.55, damping: 0.92, position: 0.32 }

# Strike D2 from the 9 s gate; sympathetic coupling into A2 and D3.
g6 -> str_d2.strike
str_d2.out -> str_a2.in : 0.05
str_d2.out -> str_d3.in : 0.05

# Subtle LFO drift on v_oct for chorus-y detuning (0.005 oct = +-6 cents).
l2 -> str_d2.v_oct : 0.005
l3 -> str_a2.v_oct : 0.005
l4 -> str_d3.v_oct : 0.005

# === BOWED PINK-NOISE PAD ===
# Pink noise into a slow VCA (LFO A swells it) into a warm ladder LP.
pn = noise { color: pink, seed: 5 }
pad_vca = vca { gain: 0.0 }
pad_lp = ladder { cutoff: 900hz, res: 0.2, drive: 0.6 }
0.45 -> pad_vca.gain
l1 -> pad_vca.gain : 0.45
pn -> pad_vca.in
pad_vca -> pad_lp.in

# === SUB: D1 sine, slow tremolo ===
sub_osc = vco { freq: 36.71hz, wave: sine }
sub_vca = vca { gain: 0.0 }
sub_osc -> sub_vca.in
0.15 -> sub_vca.gain
l2 -> sub_vca.gain : 0.10

# === SPARSE SINE EVENTS (every 18 s, bern 0.30) ===
ev_pulse = bern { prob: 0.30, seed: 5 }
ev_env = adsr { attack: 1.5, decay: 4, sustain: 0.4, release: 6 }
ev_vca = vca { gain: 0.0 }
ev_osc = vco { freq: 220hz, wave: sine }
g12 -> ev_pulse.gate
ev_pulse -> ev_env.gate
ev_env -> ev_vca.gain
ev_osc -> ev_vca.in
q1 -> ev_osc.v_oct

# === MIX: voice bus ===
bus = mix { levels: [0.5, 0.5, 0.5, 0.7, 0.75, 0.5] }
str_d2 -> bus.in1
str_a2 -> bus.in2
str_d3 -> bus.in3
pad_lp -> bus.in4
sub_vca -> bus.in5
ev_vca -> bus.in6

# === FX: long warm plate reverb + dotted-half delay ===
fx = mix { levels: [0.6, 0.6] }
rev = reverb { decay: 0.92, damp: 0.32, mix: 1, predelay: 0.025,
               bandwidth: 0.92, mod_rate: 0.3, mod_depth: 18 }
del = delay { time: 4.5s, feedback: 0.4, mix: 1, tone: 2400, slew: 0.3 }
bus.out_l -> fx.in1
bus.out_r -> fx.in2
fx.out_l -> rev.in_l
fx.out_r -> rev.in_r
fx.out_l -> del.in

# === MASTER: dry bus + reverb + delay, hard-panned L/R ===
master = mix { levels: [1, 1, 0.55, 0.55, 0.5],
               pans: [-1, 1, -1, 1, 0] }
bus.out_l -> master.in1
bus.out_r -> master.in2
rev.out_l -> master.in3
rev.out_r -> master.in4
del.out -> master.in5

# === MASTERING ===
dc = dcblock { cutoff: 15hz }
eq_m = eq { hp_freq: 30, low_freq: 100, low_gain: -0.4,
            mid1_freq: 500, mid1_gain: -0.3, mid1_q: 0.8,
            mid2_freq: 4000, mid2_gain: 0.4, mid2_q: 0.8,
            high_freq: 10000, high_gain: 0.3 }
comp_m = compressor { threshold: -18, ratio: 2.0, knee: 8,
                      attack: 0.05, release: 0.3, makeup: 3.0, mix: 1 }
field = stereo { width: 1.2, balance: 0 }
clip = clipper { mode: soft, threshold: -3, drive: 0.5, mix: 0.5 }
lim = limiter { threshold: -1.0, release: 0.15 }

master.out_l -> dc.in_l
master.out_r -> dc.in_r
dc.out_l -> eq_m.in_l
dc.out_r -> eq_m.in_r
eq_m.out_l -> comp_m.in_l
eq_m.out_r -> comp_m.in_r
comp_m.out_l -> field.in_l
comp_m.out_r -> field.in_r
field.out_l -> clip.in_l
field.out_r -> clip.in_r
clip.out_l -> lim.in_l
clip.out_r -> lim.in_r
lim.out_l -> out.left
lim.out_r -> out.right
-0.2 -> out.level
