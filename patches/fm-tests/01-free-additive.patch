# free — additive sine stack: six carriers at the first six harmonics, a
# drawbar-organ voicing. Tests: algo free, multi-carrier out sum, levels.
clk = clock { bpm: 200 }
wander = random { rate: 2.3, smooth: 0, seed: 3 }
notes = sh { mode: sample }
wander -> notes.in
clk -> notes.trig
key = quant { scale: [0, 4, 7, 11] }
notes -> key.in
poly = alloc { n: 4 }
clk -> poly.gate
key -> poly.voct
ep = voice { notes: poly }
ep.fm = fm { algo: free, freq: 165hz,
             ratios: [1, 2, 3, 4, 5, 6],
             levels: [.5, .26, .17, .12, .09, .07],
             t1: [.004, .004, .004, .004, .004, .004],
             t2: [.05, .05, .05, .05, .05, .05],
             t3: [.1, .1, .1, .1, .1, .1],
             l1: [1, 1, 1, 1, 1, 1], l2: [1, 1, 1, 1, 1, 1], l3: [.9, .9, .9, .9, .9, .9],
             t4: [.3, .3, .3, .3, .3, .3] }
poly.voct -> ep.fm.v_oct
poly.gate -> ep.fm.gate
ep.fm -> out.in : 0.3
-0.3 -> out.level
