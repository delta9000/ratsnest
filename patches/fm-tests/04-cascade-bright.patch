# cascade — one deep 6-op stack (6->5->4->3->2->1). Extreme brightness and the
# characteristic FM alias grit. Tests: algo cascade, deep same-sample topo order.
clk = clock { bpm: 210 }
wander = random { rate: 2.0, smooth: 0, seed: 12 }
notes = sh { mode: sample }
wander -> notes.in
clk -> notes.trig
key = quant { scale: [0, 2, 3, 5, 7, 10] }
notes -> key.in
poly = alloc { n: 3 }
clk -> poly.gate
key -> poly.voct
ep = voice { notes: poly }
ep.fm = fm { algo: cascade, freq: 165hz,
             ratios: [1, 2, 1, 3, 1, 2],
             levels: [.5, .5, .4, .3, .2, .12],
             t2: [1, 1, 1, 1, 1, 1], t3: [2, 2, 2, 2, 2, 2],
             l2: [.6, .55, .5, .45, .4, .35], l3: [.4, .3, .25, .2, .15, .1],
             t4: [1.25, 1.25, 1.25, 1.25, 1.25, 1.25], curve: exp }
poly.voct -> ep.fm.v_oct
poly.gate -> ep.fm.gate
ep.fm -> out.in : 0.25
-0.4 -> out.level
