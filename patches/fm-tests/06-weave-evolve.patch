# weave — asymmetric converging tree (6,5->4->2, 3->2, 2->1) with a feedback
# op, staggered envelopes so the timbre evolves through the note. Tests: algo
# weave, feedback + routing together, per-op envelope divergence.
clk = clock { bpm: 180 }
wander = random { rate: 1.9, smooth: 0, seed: 29 }
notes = sh { mode: sample }
wander -> notes.in
clk -> notes.trig
key = quant { scale: [0, 2, 4, 7, 9] }
notes -> key.in
poly = alloc { n: 4 }
clk -> poly.gate
key -> poly.voct
ep = voice { notes: poly }
ep.fm = fm { algo: weave, freq: 220hz,
             ratios: [1, 2, 3, 1.5, 4, 7],
             levels: [.5, .35, .25, .3, .2, .15],
             fb: [0, 0, 0, .4, 0, 0],
             t2: [.4, .8, .2, 1.2, .3, .15], t3: [.6, .5, .4, .8, .4, .3],
             l2: [.6, .5, .4, .6, .35, .3], l3: [.35, .2, .1, .3, .1, .05],
             t4: [.4, .4, .4, .4, .4, .4], curve: log }
poly.voct -> ep.fm.v_oct
poly.gate -> ep.fm.gate
ep.fm -> out.in : 0.3
-0.35 -> out.level
