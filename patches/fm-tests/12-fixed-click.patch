# fixed op — op2 is pinned to a fixed 2.5 kHz (ignores pitch) with a click-short
# envelope, so every note gets the same metallic attack transient over a carrier
# that tracks pitch normally. Tests: fixed[] pinning, custom route, transient design.
clk = clock { bpm: 240 }
wander = random { rate: 3.3, smooth: 0, seed: 19 }
notes = sh { mode: sample }
wander -> notes.in
clk -> notes.trig
key = quant { scale: [0, 3, 5, 7, 10] }
notes -> key.in
poly = alloc { n: 3 }
clk -> poly.gate
key -> poly.voct
ep = voice { notes: poly }
ep.fm = fm { algo: custom, route: [2, 1], freq: 220hz,
             fixed: [0, 2500, 0, 0, 0, 0],
             ratios: [1, 1, 0, 0, 0, 0],
             levels: [.55, .7, 0, 0, 0, 0],
             t1: [.001, .0005, .002, .002, .002, .002],
             t2: [.7, .004, .5, .5, .5, .5],
             t3: [1.25, .004, 2, 2, 2, 2],
             l2: [.5, 0, .75, .75, .75, .75], l3: [.25, 0, .5, .5, .5, .5],
             t4: [1.25, .01, 1, 1, 1, 1], curve: exp }
poly.voct -> ep.fm.v_oct
poly.gate -> ep.fm.gate
ep.fm -> out.in : 0.4
-0.35 -> out.level
