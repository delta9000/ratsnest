# fallback — `route: [1,2, 2,1]` is a cycle (1->2->1), which is illegal. Instead
# of failing, the module falls back to `free` and keeps playing as an additive
# stack (rule 6: a bad config never kills the session). Tests: route validation
# + graceful fallback. Fix the route to hear the intended topology.
clk = clock { bpm: 200 }
wander = random { rate: 2.3, smooth: 0, seed: 61 }
notes = sh { mode: sample }
wander -> notes.in
clk -> notes.trig
key = quant { scale: [0, 4, 7, 11] }
notes -> key.in
poly = alloc { n: 4 }
clk -> poly.gate
key -> poly.voct
ep = voice { notes: poly }
ep.fm = fm { algo: custom, route: [1, 2, 2, 1], freq: 165hz,
             ratios: [1, 2, 3, 4, 5, 6],
             levels: [.5, .26, .17, .12, .09, .07],
             t2: [.05, .05, .05, .05, .05, .05], t3: [.1, .1, .1, .1, .1, .1],
             l2: [1, 1, 1, 1, 1, 1], l3: [.9, .9, .9, .9, .9, .9],
             t4: [.3, .3, .3, .3, .3, .3] }
poly.voct -> ep.fm.v_oct
poly.gate -> ep.fm.gate
ep.fm -> out.in : 0.3
-0.3 -> out.level
