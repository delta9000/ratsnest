# brass — cascade at ratio 1:1 with slow modulator attacks, so the modulation
# index (brightness) swells in behind the note like a horn. Tests: envelope
# controlling index over time, sustained voice.
clk = clock { bpm: 90 }
wander = random { rate: 0.9, smooth: 0, seed: 44 }
notes = sh { mode: sample }
wander -> notes.in
clk -> notes.trig
key = quant { scale: [0, 5, 7, 12] }
notes -> key.in
poly = alloc { n: 3 }
clk -> poly.gate
key -> poly.voct
ep = voice { notes: poly }
ep.fm = fm { algo: cascade, freq: 165hz,
             ratios: [1, 1, 1, 2, 1, 1],
             levels: [.5, .5, .4, .3, .2, .1],
             t1: [.06, .18, .22, .26, .3, .3],
             t2: [.2, .3, .35, .4, .4, .4],
             t3: [.3, .3, .3, .3, .3, .3],
             l1: [1, 1, 1, 1, 1, 1], l2: [.9, .85, .8, .75, .7, .6], l3: [.85, .8, .75, .7, .6, .5],
             t4: [.3, .3, .3, .3, .3, .3], curve: lin }
poly.voct -> ep.fm.v_oct
poly.gate -> ep.fm.gate
ep.fm -> out.in : 0.3
-0.4 -> out.level
