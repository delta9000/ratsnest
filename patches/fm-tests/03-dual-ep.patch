# dual — Rhodes-style electric piano: two 3-op stacks (3->2->1, 6->5->4).
# A bright feedback tine on op3, velocity opening the modulators.
# Tests: algo dual, feedback, vel_sens + live vel, log curve.
clk = clock { bpm: 250 }
wander = random { rate: 2.7, smooth: 0, seed: 21 }
notes = sh { mode: sample }
wander -> notes.in
clk -> notes.trig
key = quant { scale: [0, 3, 5, 7, 10] }
notes -> key.in
poly = alloc { n: 4 }
clk -> poly.gate
key -> poly.voct
vgen = random { rate: 6, smooth: 0, seed: 5 }
-0.5 -> poly.vel
vgen -> poly.vel : 0.6
ep = voice { notes: poly }
ep.fm = fm { algo: dual,
             ratios: [1, 1, 14, 1, 3.5, 1],
             levels: [.5, .3, .15, .4, .12, .16],
             fb: [0, 0, .26, 0, 0, 0],
             vel_sens: [.3, .7, .85, .3, .7, .7],
             t1: [.001, .001, .001, .001, .001, .001],
             t2: [.5, .09, .06, .45, .07, .09],
             t3: [1.4, .35, .2, 1.1, .3, .3],
             t4: [.3, .3, .3, .3, .3, .3],
             l2: [.55, .25, .2, .5, .2, .25],
             l3: [.2, 0, 0, .16, 0, 0],
             curve: log }
poly.voct -> ep.fm.v_oct
poly.vel  -> ep.fm.vel
poly.gate -> ep.fm.gate
ep.fm -> out.in : 0.4
-0.35 -> out.level
