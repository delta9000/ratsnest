# kit/hat.sub -- struck-metal hat, 808-architecture: the six 808 oscillator
# ratios expanded by their odd harmonics (each source is square-ish, so its
# partial stack comes too — 40 modes of dense inharmonic hash, not six bare
# sines) through a high bandpass, plus a noise-spit layer. Sparse sine banks
# read as a struck rod; density is what makes metal shimmer. One file, both
# hats: instance with short decay for closed, long for open, and cable the
# closed hat's trig into the open instance's choke. Ratios:
# docs/attribution.md (808 bases x odd multiples 1..13, ceiling 44).
tune   = param { default: 450hz }   # hash base; audible content set by tone
decay  = param { default: 0.2 }     # 0..1 ring amount onto modal.damping
tone   = param { default: 8khz }    # output bandpass centre (the swish)
trig   = input {}
accent = input { default: 0.7 }
choke  = input {}
main   = output {}

acc = sh {}
accent -> acc.in
trig -> acc.trig

# Effective brightness = 0.44 + acc * 0.3 (0.65 at default accent).
metal = modal { ratios: [1, 1.483, 1.8, 2.546, 2.63, 3, 3.897, 4.449, 5,
                         5.4, 7, 7.415, 7.638, 7.89, 9, 10.381, 11, 11.691,
                         12.6, 12.73, 13, 13.15, 13.347, 16.2, 16.313,
                         17.822, 18.41, 19.279, 19.485, 19.8, 22.914, 23.4,
                         23.67, 27.279, 28.006, 28.93, 33.098, 34.19,
                         35.073, 42.867],
                freq: tune, damping: decay, brightness: 0.44, position: 0.25 }
acc -> metal.brightness : 0.3

# Excitation: 25 ms noise burst into the bank; the same burst feeds the
# spit layer below.
xn = noise { color: white, seed: 23 }
benv = func { rise: 0.0002, fall: 0.025 }
trig -> benv.trig
bamp = vca { gain: 0 }
xn -> bamp.in
benv -> bamp.cv
bamp -> metal.in

# The swish: hash through a high bandpass (the 808 keeps only the upper
# harmonic interference of its oscillator bank).
post = svf { cutoff: tone, res: 0.15 }
metal -> post.in

# Attack spit: a little bandpassed noise on top.
szf = svf { cutoff: 9khz, res: 0.1 }
bamp -> szf.in

# Choke: slam the accent VCA shut (cv sums, gain clamps at 0) and let it
# recover as the 20 ms cut envelope falls.
chk = func { rise: 0.0005, fall: 0.02 }
choke -> chk.trig

lvl = vca { gain: 0.5 }
post.bp -> lvl.in : 1.0
szf.bp -> lvl.in : 0.5
acc -> lvl.cv : 0.5
chk -> lvl.cv : -8
lvl -> main.in : 1.35

# Audition: `mise run play -- patches/lib/kit/hat.sub`
demo.clk = clock { bpm: 240 }
demo.clk -> trig
main -> demo.out.in : 0.7
