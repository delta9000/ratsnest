# kit/hat.sub -- struck-metal hat: TR-808-cluster modal bank flashed by a
# 40 ms noise burst, under a bandpassed noise sizzle layer. The sizzle is
# the body and the bank is the colour: six clean sine modes alone read as a
# glass clink, so the burst is long (stochastic excitation smears the ring),
# the ring is short, and the noise carries the "tss". One file, both hats:
# instance with short decay for closed, long for open, and cable the closed
# hat's trig into the open instance's choke. Ratios: docs/attribution.md.
tune   = param { default: 1.8khz }  # cluster base; bank spans ~1.8-7 kHz
decay  = param { default: 0.15 }    # 0..1 ring amount onto modal.damping
tone   = param { default: 6khz }    # sizzle bandpass centre
trig   = input {}
accent = input { default: 0.7 }
choke  = input {}
main   = output {}

acc = sh {}
accent -> acc.in
trig -> acc.trig

# Effective brightness = 0.44 + acc * 0.3 (0.65 at default accent).
# position 0.12 tilts the comb down across the cluster with no nulled mode
# (0.25 zeroes mode index 2 outright).
metal = modal { ratios: [1, 1.483, 1.8, 2.546, 2.63, 3.897],
                freq: tune, damping: decay, brightness: 0.44, position: 0.12 }
acc -> metal.brightness : 0.3

# Excitation: 40 ms noise burst into the bank's exciter input; the same
# burst feeds the sizzle path below.
xn = noise { color: white, seed: 23 }
benv = func { rise: 0.0002, fall: 0.04 }
trig -> benv.trig
bamp = vca { gain: 0 }
xn -> bamp.in
benv -> bamp.cv
bamp -> metal.in

# Sizzle: the burst through its own bandpass — the snare's body+noise
# architecture, inverted: here noise dominates and metal colours it.
szf = svf { cutoff: tone, res: 0.1 }
bamp -> szf.in

# Choke: slam the accent VCA shut (cv sums, gain clamps at 0) and let it
# recover as the 20 ms cut envelope falls.
chk = func { rise: 0.0005, fall: 0.02 }
choke -> chk.trig

lvl = vca { gain: 0.5 }
metal -> lvl.in : 0.45
szf.bp -> lvl.in : 1.1
acc -> lvl.cv : 0.5
chk -> lvl.cv : -8
lvl -> main.in : 1.0

# Audition: `mise run play -- patches/lib/kit/hat.sub`
demo.clk = clock { bpm: 240 }
demo.clk -> trig
main -> demo.out.in : 0.7
