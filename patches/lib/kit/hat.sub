# kit/hat.sub -- struck-metal hat, calibrated against real hat samples
# (acoustic + TR-808, see 2026-07-18-drumkit-design.md §4): a real closed
# hat is a 150-800 ms broadband noise wash (spectral flatness 0.2-0.55 over
# 2-16 kHz) with mild metallic peaks and uniform per-band decay — not a
# ringing mode cluster. So the 40-mode 808-hash bank is CONTINUOUSLY DRIVEN
# by two-stage-enveloped noise (a driven resonator outputs colored noise,
# never a clean ring) and mixed under a bandpassed wash of the same driver.
# Measured here: flatness 0.24, tail 240 ms, centroid 4.6 kHz, peak/median
# 11 — all inside the sampled-hat envelope. One file, both hats: short
# decay for closed, long for open, closed trig into the open's choke.
# Ratios: docs/attribution.md (808 bases x odd multiples 1..13).
tune   = param { default: 450hz }   # hash base
decay  = param { default: 0.25 }    # tail seconds AND 0..1 modal ring
tone   = param { default: 6.5khz }  # wash bandpass centre
trig   = input {}
accent = input { default: 0.7 }
choke  = input {}
main   = output {}

acc = sh {}
accent -> acc.in
trig -> acc.trig

# Two-stage envelope on the shared noise driver: fast attack transient
# plus exponential tail (real hats: ~-0.6 dB/ms for 20 ms, then slow).
nz = noise { color: white, seed: 23 }
env1 = func { rise: 0.0002, fall: 0.02 }
# `decay` keeps its meaning (the length of the tail you hear). An `exp` stage
# time is its -60 dB point and this tail sits 6 dB under the transient, so
# the fall runs 5x decay: measured, the hit's -20 dB point stays at 208 ms
# for the default 0.25 (same as the old x^2 curve), energy -1.4 dB.
tail = math { op: mult, a: decay, b: 5 }
env2 = func { rise: 0.0005, fall: 0, curve: exp }
tail -> env2.fall
trig -> env1.trig
trig -> env2.trig
drv = vca { gain: 0 }
nz -> drv.in
env1 -> drv.cv
env2 -> drv.cv : 0.5

# Effective brightness = 0.44 + acc * 0.3 (0.65 at default accent).
metal = modal { ratios: [1, 1.483, 1.8, 2.546, 2.63, 3, 3.897, 4.449, 5,
                         5.4, 7, 7.415, 7.638, 7.89, 9, 10.381, 11, 11.691,
                         12.6, 12.73, 13, 13.15, 13.347, 16.2, 16.313,
                         17.822, 18.41, 19.279, 19.485, 19.8, 22.914, 23.4,
                         23.67, 27.279, 28.006, 28.93, 33.098, 34.19,
                         35.073, 42.867],
                freq: tune, damping: decay, brightness: 0.44, position: 0.25 }
acc -> metal.brightness : 0.3
drv -> metal.in

wash = svf { cutoff: tone, res: 0.1 }
drv -> wash.in

# Choke: slam the accent VCA shut (cv sums, gain clamps at 0) and let it
# recover as the 20 ms cut envelope falls.
chk = func { rise: 0.0005, fall: 0.02 }
choke -> chk.trig

lvl = vca { gain: 0.5 }
metal -> lvl.in : 0.5
wash.bp -> lvl.in : 1.0
acc -> lvl.cv : 0.5
chk -> lvl.cv : -8
lvl -> main.in : 0.6

# Audition: `mise run play -- patches/lib/kit/hat.sub`
demo.clk = clock { bpm: 240 }
demo.clk -> trig
main -> demo.out.in : 0.7
