# bass.sub -- clean saw bass with envelope-controlled VCA.
# No FM, no LPG — just a saw through an amp.
pitch = param { default: G1 }       # fundamental
decay = param { default: 0.18s }    # envelope decay
trig  = input {}
main  = output {}

env = func { rise: 0.003s, fall: decay }
trig -> env.trig
osc = vco { wave: saw, freq: pitch }
amp = vca { gain: 0 }
osc -> amp.in
env -> amp.cv
amp -> main.in

# Audition: `mise run play -- patches/lib/bass.sub`
demo.clk = clock { bpm: 120 }
demo.seq = stepseq { steps: [G1v, A1v, C2v, G1v], gates: [1, 0, 0, 0] }
demo.clk -> demo.seq.clock
demo.seq.cv -> osc.v_oct
demo.clk -> trig : 2.0
main -> demo.out.in : 0.5
