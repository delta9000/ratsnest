# bass.sub -- FM bass voice with a low-pass gate and envelope-controlled growl.
# Saw core through an LPG with optional FM grit.
pitch = param { default: G1 }       # fundamental
decay = param { default: 0.18s }    # envelope decay
res   = param { default: 0.0 }      # unused, kept for API compat
grit  = param { default: 0.0 }      # FM index (escape hatch: push into osc.fm directly)
trig  = input {}
main  = output {}

env = func { rise: 0.001s, fall: decay }
trig -> env.trig
osc = vco { wave: saw, freq: pitch }
fm_osc = vco { wave: sine, freq: pitch }
1 -> fm_osc.v_oct
env -> fm_osc.v_oct : 0.3
fm_osc -> osc.fm : grit
lpg = lpg { damp: 0.3, decay: decay }
osc -> lpg.in
trig -> lpg.strike
env -> lpg.cv : 0.9
lpg -> main.in

# Audition: `mise run play -- patches/lib/bass.sub`
demo.clk = clock { bpm: 120 }
demo.seq = stepseq { steps: [G1v, A1v, C2v, G1v], gates: [1, 0, 0, 0] }
demo.clk -> demo.seq.clock
demo.seq.cv -> osc.v_oct
demo.clk -> trig : 2.0
main -> demo.out.in : 0.5
