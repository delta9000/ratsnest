# twist.trk -- "Twist", Headless track 5. 128 BPM acid, A minor, 16 rows per
# bar, 96 bars. Every step is two bars of the same acid line; the line moves
# Am (x4) - F (x2) - G (x2) per 16 bars by transposing the layer.
# intro 8 | A 16 | B 16 (the speech engine says the motif) | break 8 |
# C 24 | outro 16 | end 8

track kick  note len 1        # 1
track clap  note vel len 1    # 2
track hat   note vel len 1    # 3
track ohat  note vel len 1    # 4
track acid  note vel          # 5  Surge Twist; ~ is a slide
track talk  note vel          # 6  Surge Twist, vowels/speech engine

pattern acid 2x16 acid
00 | A1 .95
02 | A2 .55
03 | ~C3 .7
04 | A1 .8
06 | E2 .55
07 | ~G2 .7
08 | A1 1
10 | C2 .55
11 | ~A2 .7
12 | off
13 | G1 .8
14 | ~A1 .9
16 | A1 .95
18 | A2 .55
19 | ~B2 .6
20 | A1 .8
22 | E3 .75
23 | ~D3 .6
24 | C2 1
26 | C3 .55
27 | ~E3 .7
28 | D2 .8
30 | E2 .7
31 | ~G2 .85

pattern kick 16 kick
lane kick x...x...x...x...

pattern kick_end 2x16 kick
lane kick x...x...x...x...x...x.....x.....

pattern clap 16 clap
lane clap ....8.......8...

pattern clap_roll 2x16 clap
lane clap ....8.......8.......8.......4444

pattern hat 16 hat
lane hat 5.3.5.3.5.3.5.36

pattern ohat 16 ohat
lane ohat ..7...7...7...7.

# The motif, A C B E, sung by the speech engine.
pattern talk 2x16 talk
1:00 | A4 .8
1:04 | C5 .7
1:08 | B4 .7
1:12 | E5 .9
2:06 | off

section i    acid+kick+hat
section i4   acid^-4+kick+hat
section i2   acid^-2+kick+hat
section a    acid+kick+hat+clap
section a4   acid^-4+kick+hat+clap
section a2   acid^-2+kick+hat+clap
section ar   acid^-2+kick+hat+clap_roll
section b    acid+kick+hat+clap+ohat
section bt   acid+kick+hat+clap+ohat+talk
section b4   acid^-4+kick+hat+clap+ohat
section b4t  acid^-4+kick+hat+clap+ohat+talk^-4
section b2   acid^-2+kick+hat+clap+ohat
section k    acid+hat
section k4   acid^-4+hat
section kr   acid^-2+clap_roll
section e    acid+kick_end

order i i i i
order a a a a a4 a4 a2 ar
order bt b bt b b4t b4 b2 ar
order k k k4 kr
order bt b bt b b4t b4 b2 ar
order bt b b b
order a a a a a4 a4 a2 a2
order i i i e
