# twist-form.trk -- one row per bar (96).
track cut   cva   # 1  ladder cutoff (p, normalized)
track res   cva   # 2  ladder resonance (p, normalized)
track drive cva   # 3  Surge's own distortion (p, normalized drive)
track acid  cva   # 4  bass level
track drums cva   # 5
track talk  cva   # 6
track verb  cva   # 7
track main  cva   # 8

