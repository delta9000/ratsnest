# window-form.trk -- one row per bar (46).
track pad    cva   # 1
track glint  cva   # 2  ratsnest mallets
track motif  cva   # 3
track freeze cva   # 4  Nimbus freeze (0 off, 1 on)
track morph  cva   # 5  Window morph base (p)
track cloud  cva   # 6  ratsnest frozen cloud of the pads
track main   cva   # 7

