# drain-em-all -- "Drain em all": dark industrial techno for a machine room,
# 132 BPM, E phrygian, 112 bars (~3:24). Notes in drain-em-all.trk, one form
# row per bar in drain-em-all-form.trk. Score drafted with DeepSeek-V4.1-Flash.
# After Virginia Tech's ARC HPC center: the hum, the fans, the status LEDs,
# the scheduler filling the queue, then `scontrol update state=drain`.
#   1-16 power on: hum, fans, pad, LED blinks | 17-32 queue fills: kick, hats, bass 25
#   33-48 dispatch: jobs arp (polymeter), clap, open hats | 49-64 full load: pager lead
#   65-72 maintenance window: no kick/bass, riser + roll | 73-88 peak, jobs +8va at 81
#   89-104 drain: one part leaves every 4 bars | 105-112 drained: fans spin down
# Voices are synth-voice.sub, channels strip.sub, one duck.sub per depth off the kick.

t    = transport { bpm: 132, division: 4, swing: 0.06 }
song = tracker { file: "drain-em-all.trk" }
form = tracker { file: "drain-em-all-form.trk" }
t.clock -> song.clock
t.bar   -> form.clock

# ---- slewed form lanes ----
bass_lvl  = func { rise: 0.05, fall: 0.3 }
jobs_lvl  = func { rise: 1, fall: 0.6 }
jobs_cut  = func { rise: 1.8, fall: 0.8 }
pad_lvl   = func { rise: 3, fall: 2 }
hum_lvl   = func { rise: 4, fall: 3 }
fan_lvl   = func { rise: 5, fall: 6 }
riser_lvl = func { rise: 1.8, fall: 0.05 }
verb_lvl  = func { rise: 2, fall: 2 }
form.cva1 -> bass_lvl.in
form.cvb1 -> jobs_lvl.in
form.cva2 -> jobs_cut.in
form.cvb2 -> pad_lvl.in
form.cva3 -> hum_lvl.in
form.cvb3 -> fan_lvl.in
form.cva4 -> riser_lvl.in
form.cvb4 -> verb_lvl.in

# ---- the pump ----
duck_bass = sub { file: "../lib/duck.sub", depth_db: -12, release: 0.7, curve: exp }
duck_mid  = sub { file: "../lib/duck.sub", depth_db: -5, release: 0.7, curve: exp }
duck_bed  = sub { file: "../lib/duck.sub", depth_db: -3, release: 0.9, curve: exp }
song.gate1 -> duck_bass.trig
song.gate1 -> duck_mid.trig
song.gate1 -> duck_bed.trig

# ---- drums: driven kick, metallic hats, clap; a mono kit mix ----
kick = sub { file: "../lib/kick.sub", tune: 47hz, decay: 0.2s, click: 0.5 }
song.gate1 -> kick.trig
kdrv = drive { amount: 0.6, mode: soft }
kick -> kdrv.in : 0.8
chat = sub { file: "../lib/kit/hat_model.sub", decay: 0.045, tone: 9khz }
ohat = sub { file: "../lib/kit/hat_model.sub", decay: 0.3, tone: 8khz }
song.gate2 -> chat.trig
song.vel2  -> chat.accent
song.gate3 -> ohat.trig
song.vel3  -> ohat.accent
song.gate2 -> ohat.choke
clap = sub { file: "../lib/kit/clap.sub", decay: 0.2, tune: 1.3khz }
song.gate4 -> clap.trig
song.vel4  -> clap.accent
#        kick  chat  ohat  clap
kit = mix { levels: [0.7, 0.45, 0.32, 0.5], pans: [0, 0.3, -0.3, 0] }
kdrv -> kit.in1
chat -> kit.in2
ohat -> kit.in3
clap -> kit.in4

# ---- machine room: a transformer hum tuned to E, and the fans ----
hum = additive { freq: E1, levels: [0.5, 0.35, 0.22, 0.15, 0.08, 0.06], ratios: [1, 2, 3, 4, 6, 8] }
hum2 = additive { freq: 41.5hz, levels: [0.3, 0.2, 0.1], ratios: [2, 3, 4] }
hum_f = svf { cutoff: 420, res: 0.1 }
hum  -> hum_f.in
hum2 -> hum_f.in
hum_s = sub { file: "../lib/strip.sub", gain: 0.07 }
hum_f -> hum_s.in
hum_lvl -> hum_s.level
duck_bed -> hum_s.duck

fan_n  = noise { color: pink, seed: 3 }
fan_bp = svf { cutoff: 180, res: 0.25 }
fan_n -> fan_bp.in
fan_lvl -> fan_bp.cutoff : 700      # spinning down lowers the roar
flutter = lfo { freq: 23hz, wave: sine }
fan_amp = vca { gain: 0.8 }
flutter -> fan_amp.cv : 0.12
fan_bp.bp -> fan_amp.in
# blade-pass whine: pitch rides the fan speed, so spin-down is audible
whine = vco { freq: 380hz, wave: tri }
fan_lvl -> whine.freq : 1100
whine_a = vca { gain: 0.03 }
whine -> whine_a.in
fan_s = sub { file: "../lib/strip.sub", gain: 0.9, width: 1 }
fan_amp -> fan_s.in_l
whine_a -> fan_s.in_l
fan_n2 = noise { color: pink, seed: 9 }
fan_bp2 = svf { cutoff: 220, res: 0.25 }
fan_n2 -> fan_bp2.in
fan_lvl -> fan_bp2.cutoff : 760
fan_bp2.bp -> fan_s.in_r : 0.8
fan_lvl -> fan_s.level
duck_bed -> fan_s.duck

# ---- status LEDs: tiny sine blips, high, through a dotted echo ----
blink = sub { file: "../lib/synth-voice.sub", wave1: sine, blend: 0, cutoff: 9000,
              env_amt: 0, track: 0, attack: 0.001, decay: 0.05, sustain: 0, release: 0.05 }
song.voct6 -> blink.voct
song.gate6 -> blink.gate
song.vel6  -> blink.level
blink_s = sub { file: "../lib/strip.sub", gain: 1.4, pos: 0.45, send_gain: 0.6 }
blink -> blink_s.in

# ---- pad: three saws, dark, on harm ----
pad = sub { file: "../lib/poly-pad.sub", n: 3, blend: 0, osc_lvl: 0.3, track: 0,
            cutoff: 520, res: 0.25, hp: 200, attack: 0.8 }
song.gate5 -> pad.gate
song.voct5 -> pad.p1
song.cva5  -> pad.p2
song.cvb5  -> pad.p3
0.006  -> pad.p2
-0.006 -> pad.p3
riser_lvl -> pad.cut : 2200
pad_s = sub { file: "../lib/strip.sub", gain: 1.5, send_gain: 0.2 }
pad -> pad_s.in
pad_lvl -> pad_s.level
duck_mid -> pad_s.duck
p_cho = chorus { voices: 3, depth: 0.6, mix: 0.5 }
pad_s.l -> p_cho.in_l
pad_s.r -> p_cho.in_r

# ---- bass: saw + sine sub, gritty ladder pluck ----
bass = sub { file: "../lib/synth-voice.sub", blend: 0, osc_lvl: 0.6, sublvl: 0.85,
             sub_oct: 0, cutoff: 150, res: 0.35, drive: 0.7, track: 0, env_amt: 1000,
             attack: 0.002, decay: 0.25, sustain: 0, release: 0.25 }
song.voct7 -> bass.voct
song.gate7 -> bass.gate
song.vel7  -> bass.level
bass_s = sub { file: "../lib/strip.sub", gain: 1.6 }
bass -> bass_s.in
bass_lvl -> bass_s.level
duck_bass -> bass_s.duck

# ---- jobs: the parallel-jobs arp, pulse pluck, cutoff lane ----
jobs = sub { file: "../lib/synth-voice.sub", wave1: pulse, wave2: saw, blend: 0.3, detune: 0.005,
             cutoff: 300, res: 0.5, drive: 0.3, track: 0.3, env_amt: 1500, hp: 200,
             attack: 0.001, decay: 0.18, sustain: 0, release: 0.15 }
song.voct8 -> jobs.voct
song.gate8 -> jobs.gate
song.vel8  -> jobs.vel
jobs_cut -> jobs.cut : 3200
jobs_s = sub { file: "../lib/strip.sub", gain: 2.4, pos: -0.15, send_gain: 0.25 }
jobs -> jobs_s.in
jobs_lvl -> jobs_s.level
duck_mid -> jobs_s.duck

# ---- lead: the pager -- hollow square, a little vibrato ----
lead = sub { file: "../lib/synth-voice.sub", wave1: pulse, wave2: pulse, oct2: 1, blend: 0.25,
             cutoff: 1500, res: 0.3, slope: 0, track: 0.5, env_amt: 1800,
             attack: 0.003, decay: 0.3, sustain: 0.55, release: 0.12, vib: 0.008, vib_rate: 5.5hz }
song.voct9 -> lead.voct
song.gate9 -> lead.gate
song.vel9  -> lead.vel
lead_s = sub { file: "../lib/strip.sub", gain: 0.35, pos: 0.1, send_gain: 0.5 }
lead -> lead_s.in
duck_mid -> lead_s.duck

# ---- riser: white noise through a rising band-pass ----
rs_n = noise { color: white, seed: 11 }
rs_f = svf { cutoff: 300, res: 0.6 }
rs_n -> rs_f.in
riser_lvl -> rs_f.cutoff : 7000
rs_amp = vca { gain: 0 }
rs_f.bp -> rs_amp.in
riser_lvl -> rs_amp.cv : 0.15

# ---- space: dotted-eighth echo on blinks and lead; one big cold plate ----
de = tempo { bpm: 132, beats: 0.75 }
echo = delay { time: 0ms, feedback: 0.5, tone: 3000, mix: 1 }
de.seconds -> echo.time
blink_s.fx -> echo.in : 1.5
lead_s.fx  -> echo.in : 0.8
room = reverb { decay: 0.86, damp: 0.45, mix: 1, predelay: 0.03 }
blink_s.fx -> room.in_l : 2
jobs_s.fx  -> room.in_l : 2
pad_s.fx   -> room.in_l : 2
lead_s.fx  -> room.in_l : 2
clap       -> room.in_l : 0.3
rs_amp     -> room.in_l : 0.5
echo       -> room.in_l : 0.4
echo_s = sub { file: "../lib/strip.sub", gain: 0.45, pos: -0.3 }
echo -> echo_s.in
duck_mid -> echo_s.duck
room_s = sub { file: "../lib/strip.sub" }
room.out_l -> room_s.in_l
room.out_r -> room_s.in_r
verb_lvl -> room_s.level
duck_mid -> room_s.duck

# ---- master ----
mast = sub { file: "../lib/master-chain.sub", clip_drive: 10, clip_blend: 1,
             comp_thr: -18, ceiling: -1.5, true_peak: on, key_bus: 0.35 }
7 -> mast.makeup
kit.out_l   -> mast.in_l
kit.out_r   -> mast.in_r
hum_s.l     -> mast.in_l
hum_s.r     -> mast.in_r
fan_s.l     -> mast.in_l
fan_s.r     -> mast.in_r
blink_s.l   -> mast.in_l
blink_s.r   -> mast.in_r
p_cho.out_l -> mast.in_l
p_cho.out_r -> mast.in_r
bass_s.l    -> mast.in_l
bass_s.r    -> mast.in_r
jobs_s.l    -> mast.in_l
jobs_s.r    -> mast.in_r
lead_s.l    -> mast.in_l
lead_s.r    -> mast.in_r
rs_amp      -> mast.in_l : 0.424
rs_amp      -> mast.in_r : 0.424
echo_s.l    -> mast.in_l
echo_s.r    -> mast.in_r
room_s.l    -> mast.in_l
room_s.r    -> mast.in_r
kdrv -> mast.side_l : 0.7
kdrv -> mast.side_r : 0.7
mast.l -> out.left
mast.r -> out.right
