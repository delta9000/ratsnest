# glasshouse.trk -- "Glasshouse", synth-pop, 108 BPM, 16 rows per bar.
# intro 4 | verse 8 | pre 4 | chorus 8 | verse2 8 | pre 4 | chorus2 8 | bridge 8 | chorus x2 16 (2nd ^2) | outro 4 = 72 bars
# Verse Am7 Fmaj7 C G | Pre Dm7 Em7 Fmaj7 G | Chorus Fmaj7 G Em7 Am7 Fmaj7 G Cadd9 C | Bridge Dm7 Am7 Fmaj7 Gsus4/G

track kick  note              # 1
track snare note vel          # 2  snare+clap
track hat   note vel          # 3
track chord note cva cvb      # 4  root 3rd 5th (pad voices 1-3)
track ext   note              # 5  7th / 9th (pad voice 4)
track bass  note vel from chord   # 6
track lead  note vel          # 7
track pluck note vel from chord   # 8  intro hook, arp, chorus-2 counter
track crash note vel          # 9
track ohat  note vel          # 10
track tomhi note vel          # 11
track tomlo note vel          # 12

# ---------------- harmony ----------------
pattern h_verse 4x16 chord ext
1:00 | A3 C4 E4  | G4      # Am7
2:00 | F3 A3 C4  | E4      # Fmaj7
3:00 | C4 E4 G4  | D5      # Cadd9
4:00 | G3 B3 D4  | A4      # Gadd9

pattern h_pre 4x16 chord ext
1:00 | D4 F4 A4  | C5      # Dm7
2:00 | E4 G4 B4  | D5      # Em7
3:00 | F3 A3 C4  | E4      # Fmaj7
4:00 | G3 C4 D4  | F4      # G7sus4
4:08 | G3 B3 D4  | F4      # G7

pattern h_chorus 8x16 chord ext
1:00 | F3 A3 C4  | E4      # Fmaj7
2:00 | G3 B3 D4  | A4      # Gadd9
3:00 | E3 G3 B3  | D4      # Em7
4:00 | A3 C4 E4  | G4      # Am7
5:00 | F3 A3 C4  | E4      # Fmaj7
6:00 | G3 B3 D4  | F4      # G7
7:00 | C4 E4 G4  | D5      # Cadd9
8:00 | C4 E4 G4  | B4      # Cmaj7

pattern h_bridge 4x16 chord ext
1:00 | D4 F4 A4  | C5      # Dm7
2:00 | A3 C4 E4  | G4      # Am7
3:00 | F3 A3 C4  | E4      # Fmaj7
4:00 | G3 C4 D4  | F4      # G7sus4
4:08 | G3 B3 D4  | F4      # G7

pattern h_outro 4x16 chord ext
1:00 | F3 A3 C4  | E4      # Fmaj7
3:00 | C4 E4 G4  | D5      # Cadd9
4:12 | off       | off

# ---------------- bass riffs (follow the chord) ----------------
pattern b_eighth 16 bass
00 | t1-24 .9
02 | x .6
04 | t1-12 .8
06 | t1-24 .6
08 | x .9
10 | x .6
12 | t1-12 .8
14 | t1-24 .6

pattern b_verse 16 bass
00 | t1-24:6 .9
06 | x:2 .6
08 | x:4 .8
14 | t1-12:2 .7

pattern b_break 16 bass
00 | t1-24:14 .7

