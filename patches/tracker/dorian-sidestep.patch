# groove -- "Dorian Sidestep": E-dorian funk/house, 112 BPM, 16th swing 58%,
# 56 bars = 2:00. Score in dorian-sidestep.trk (one row per swung sixteenth).
#   1-4   intro     hats, then kit enters, short fill
#   5-12  A1        Em7 | A7 vamp, motif stated + answered, fill
#   13-20 A2        motif displaced an eighth, transposed up a fourth, fill
#   21-28 breakdown kick/snare out, long bass, motif fragments
#   29-32 build     snare roll crescendo, kick 4otf
#   33-48 peak      Cmaj7 D Em7 B7, motif up an octave, house-funk kit
#   49-56 outro     A groove, lead out, final hit
# Dynamics: every drum hit's vel drives the kit accent AND a post-VCA, so a
# ghost (.2) sits ~17 dB under an accent (1.0).

clk = transport { bpm: 112, division: 4, swing: 0.16 }   # (1+.16)/2 = 58%
song = tracker { file: "dorian-sidestep.trk" }
clk.clock -> song.clock

# ---- kit: vel -> accent and -> level ----
kick = sub { file: "../lib/kit/kick.sub", tune: 50hz }
song.gate1 -> kick.trig
song.vel1 -> kick.accent
kick_v = vca { gain: 0 }
kick.main -> kick_v.in
song.vel1 -> kick_v.cv

snare = sub { file: "../lib/kit/snare.sub", tune: 200hz }
song.gate2 -> snare.trig
song.vel2 -> snare.accent
snare_v = vca { gain: 0 }
snare.main -> snare_v.in
song.vel2 -> snare_v.cv

hat = sub { file: "../lib/kit/hat.sub", decay: 0.18 }
song.gate3 -> hat.trig
song.vel3 -> hat.accent
hat_v = vca { gain: 0 }
hat.main -> hat_v.in
song.vel3 -> hat_v.cv

ohat = sub { file: "../lib/kit/hat.sub", decay: 0.5 }
song.gate4 -> ohat.trig
song.gate3 -> ohat.choke
song.vel4 -> ohat.accent
ohat_v = vca { gain: 0 }
ohat.main -> ohat_v.in
song.vel4 -> ohat_v.cv

# pitched toms: tune at 220 Hz so tracker note names sound as written
tom = sub { file: "../lib/kit/tom.sub", tune: 220hz, decay: 0.55 }
song.gate5 -> tom.trig
song.voct5 -> tom.body.v_oct
song.vel5 -> tom.accent
tom_v = vca { gain: 0 }
tom.main -> tom_v.in
song.vel5 -> tom_v.cv

# ---- bass: saw + sub through an enveloped ladder ----
b_osc = vco { freq: 220hz, wave: saw }
b_sub = vco { freq: 110hz, wave: sine }
song.voct6 -> b_osc.v_oct
song.voct6 -> b_sub.v_oct
b_env = adsr { attack: 0.003, decay: 0.18, sustain: 0.55, release: 0.05 }
song.gate6 -> b_env.gate
b_filt = ladder { cutoff: 180, res: 0.35, drive: 0.6 }
b_osc -> b_filt.in : 0.6
b_env -> b_filt.cutoff : 900
song.vel6 -> b_filt.cutoff : 500
b_amp = vca { gain: 0 }
b_filt -> b_amp.in
b_sub -> b_amp.in : 0.5
b_env -> b_amp.cv : 0.9

# ---- lead: two detuned pulses, cva7 = brightness, small glide on slurs ----
l_glide = func { rise: 0.04, fall: 0.04 }
song.voct7 -> l_glide.in
l_a = vco { freq: 220hz, wave: pulse, pw: 0.35 }
l_b = vco { freq: 220hz, wave: saw }
l_glide -> l_a.v_oct
l_glide -> l_b.v_oct
0.004 -> l_b.v_oct
l_env = adsr { attack: 0.005, decay: 0.3, sustain: 0.6, release: 0.12 }
song.gate7 -> l_env.gate
l_filt = svf { cutoff: 600, res: 0.3 }
l_a -> l_filt.in : 0.4
l_b -> l_filt.in : 0.4
l_env -> l_filt.cutoff : 1500
song.cva7 -> l_filt.cutoff : 3000
l_amp = vca { gain: 0 }
l_filt.lp -> l_amp.in
l_env -> l_amp.cv : 0.9
l_vel = vca { gain: 0 }          # vel scales the enveloped note, never opens it
l_amp -> l_vel.in
song.vel7 -> l_vel.cv

# ---- keys: three-note stabs; vel8 = filter opening ----
k1 = vco { freq: 220hz, wave: saw }
k2 = vco { freq: 220hz, wave: saw }
k3 = vco { freq: 220hz, wave: saw }
song.voct8 -> k1.v_oct
song.cva8 -> k2.v_oct
song.cvb8 -> k3.v_oct
k_env = adsr { attack: 0.004, decay: 0.16, sustain: 0.25, release: 0.08 }
song.gate8 -> k_env.gate
k_filt = svf { cutoff: 500, res: 0.2 }
k1 -> k_filt.in : 0.25
k2 -> k_filt.in : 0.25
k3 -> k_filt.in : 0.25
k_env -> k_filt.cutoff : 1200
song.vel8 -> k_filt.cutoff : 2500
k_amp = vca { gain: 0 }
k_filt.lp -> k_amp.in
k_env -> k_amp.cv : 0.8

# ---- mix ----
band = mix { levels: [1.3, 1.1, 0.45, 0.2, 0.9, 0.75, 0.5, 0.5],
             pans: [0, 0.05, 0.3, 0.35, -0.25, 0, -0.1, 0.15] }
kick_v  -> band.in1
snare_v -> band.in2
hat_v   -> band.in3
ohat_v  -> band.in4
tom_v   -> band.in5
b_amp   -> band.in6
l_vel   -> band.in7
k_amp   -> band.in8

echo_t = tempo { bpm: 112, beats: 0.75 }
echo = delay { time: 0ms, feedback: 0.35, tone: 3000, mix: 1 }
echo_t.seconds -> echo.time
l_vel -> echo.in : 0.5
room = reverb { decay: 0.6, damp: 0.35, mix: 1 }
snare_v -> room.in_l : 0.25
k_amp   -> room.in_l : 0.3
l_vel   -> room.in_r : 0.3
tom_v   -> room.in_r : 0.2

master = mix { levels: [0.75, 0.75, 0.35, 0.35, 0.35], pans: [-1, 1, -1, 1, 0] }
band.out_l -> master.in1
band.out_r -> master.in2
room.out_l -> master.in3
room.out_r -> master.in4
echo       -> master.in5

dc = dcblock { cutoff: 15 }
master.out_l -> dc.in_l
master.out_r -> dc.in_r
lim = limiter { threshold: -1, release: 0.08 }
dc.out_l -> lim.in_l
dc.out_r -> lim.in_r
lim.out_l -> out.left
lim.out_r -> out.right
