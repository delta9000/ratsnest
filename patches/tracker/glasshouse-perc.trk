# glasshouse-perc.trk -- crash, open hat, toms. The main song has used all eight tracks,
# so this file MIRRORS glasshouse.trk's order list step for step (same lengths).
track crash note vel     # 1
track ohat  note vel     # 2
track tomhi note vel     # 3
track tomlo note vel     # 4

pattern rest4 4x16 crash
pattern rest8 8x16 crash

pattern pre_p 4x16 crash tomhi tomlo
4:08 | . | x .6 | .
4:10 | . | x .7 | .
4:12 | . | .    | x .8
4:14 | . | .    | x .9

pattern ch_p 8x16 crash
1:00 | x 1
5:00 | x .7

pattern oh 16 ohat
lane ohat ..5. ..5. ..5. ..5.

pattern verse_p 8x16 crash
1:00 | x .6

pattern out_p 4x16 crash
1:00 | x .9

section p_chorus ch_p+oh

order rest4 verse_p pre_p p_chorus
order verse_p pre_p p_chorus
order rest4 pre_p
order p_chorus p_chorus
order out_p
