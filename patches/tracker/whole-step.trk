# whole-step.trk -- "Whole Step", written with chord tones, sections and ^N.
# Verse Am F C G | Chorus F G Am E | Bridge Dm Em G F# | last chorus ^2

track kick  note                 # 1
track snare note vel             # 2
track hat   note vel             # 3
track root  note                 # 4: chord root in the bass octave (no voice)
track bass  note from root       # 5
track pad   note cva cvb         # 6: voice-led
track arp   note from pad        # 7
track lead  note vel             # 8

# ---- harmony: root + voiced pad, one chord per bar ----
pattern harm_v 4x16 root pad
1:00 | A1 | A3  C4  E4
2:00 | F1 | A3  C4  F4
3:00 | C2 | G3  C4  E4
4:00 | G1 | G3  B3  D4

pattern harm_c 4x16 root pad
1:00 | F1 | A3  C4  F4
2:00 | G1 | G3  B3  D4
3:00 | A1 | A3  C4  E4
4:00 | E1 | Gs3 B3  E4

pattern harm_br 4x16 root pad
1:00 | D2  | A3  D4  F4
2:00 | E2  | G3  B3  E4
3:00 | G1  | G3  B3  D4
4:00 | Fs1 | Fs3 As3 Cs4

# ---- one riff each, following the chord ----
pattern bass 16 bass
00 | t1
03 | x
06 | t1+12
08 | t1
11 | x
14 | t1+12

pattern arp 16 arp
00 | t1+12
02 | t2+12
04 | t3+12
06 | t1+24
08 | t3+12
10 | t2+12
12 | t1+12
14 | t2+12

# ---- melody ----
pattern mel_v 8x16 lead
1:00 | E4  .7
1:04 | A4  .8
1:06 | B4  .6
1:08 | C5  .9
1:12 | B4:2  .6
2:00 | A4  .8
2:10 | F4  .6
2:12 | A4:3  .7
3:00 | G4  .8
3:04 | E4  .6
3:08 | G4  .7
3:12 | C5:3  .8
4:00 | B4  .8
4:06 | A4  .6
4:08 | G4:4  .8
5:00 | E4  .7
5:04 | A4  .8
5:06 | B4  .6
5:08 | C5  .9
5:12 | E5:3  .9
6:00 | D5  .8
6:04 | C5  .7
6:08 | A4  .7
6:12 | C5:3  .8
7:00 | E5  .9
7:06 | D5  .7
7:08 | C5  .8
7:12 | G4:3  .7
8:00 | B4  .8
8:04 | D5:4  .7

pattern mel_c 8x16 lead
1:00 | C5  .9
1:04 | C5  .7
1:06 | A4  .7
1:08 | C5  .9
1:12 | F5:3  1
2:00 | D5  .9
2:08 | B4  .7
2:12 | D5:3  .8
3:00 | E5  1
3:04 | C5  .8
3:08 | A4  .7
3:14 | E5  .9
4:00 | D5  .8
4:04 | B4  .7
4:08 | Gs4 .7
4:12 | B4:3  .8
5:00 | C5  .9
5:04 | F5  1
5:08 | E5  .9
5:10 | D5  .8
5:12 | C5:3  .9
6:00 | B4  .8
6:04 | D5  .8
6:08 | G5  1
6:12 | F5:3  .9
7:00 | E5  1
7:08 | C5  .8
7:12 | A4:3  .8
8:00 | B4  .8
8:04 | Gs4 .7
8:08 | E4:4  .7

pattern mel_br 4x16 lead
1:00 | A4  .6
1:04 | D5  .7
1:08 | F5  .8
1:12 | E5  .7
2:00 | E5  .7
2:04 | B4  .6
2:08 | G4  .6
2:12 | B4  .7
3:00 | D5  .8
3:08 | B4  .7
3:12 | D5  .8
4:00 | Cs5 .9
4:04 | As4 .8
4:08 | Fs4 .8
4:12 | Cs5 1

# ---- drums ----
pattern beat_v 16 kick snare hat
lane kick  x... .... x.x. ....
lane snare .... 7... .... 7...
lane hat   7.4. 6.4. 7.4. 6.4.

pattern beat_c 16 kick snare hat
lane kick  x... ..x. x... ....
lane snare .... 8... .... 8..3
lane hat   8353 7353 8353 7353

pattern beat_br 16 kick hat
lane kick  x... .... .... ....
lane hat   5... .... 4... ....

pattern fill 8 kick snare
lane kick  x.0. ....
lane snare 5454 7689

pattern outro 2x16 kick root bass pad lead
1:00 | x | B1 | B1 | B3 D4 Fs4 | B4 .8

# ---- form ----
section intro  harm_v+arp
section verse  mel_v+harm_v+bass+arp+beat_v+fill@8:08
section chorus mel_c+harm_c+bass+arp+beat_c
section bridge mel_br+harm_br+bass+arp+beat_br

order intro verse chorus verse chorus bridge chorus^2 outro
