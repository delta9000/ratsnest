# stereo demo -- LFOs modulate width and balance of detuned sawtooth waves
#
# osc1 and osc2 are detuned, creating a stereo field.
# lfo_w modulates width (sweeping from mono to ultra-wide).
# lfo_b modulates balance (sweeping left and right).

osc1  = vco { freq: 110hz, wave: saw }
osc2  = vco { freq: 110.6hz, wave: saw }
lfo_w = lfo { freq: 0.15hz }
lfo_b = lfo { freq: 0.25hz }

st = stereo { width: 1.0, balance: 0.0 }

# Connect audio signals
osc1 -> st.in_l
osc2 -> st.in_r

# Modulate width: base 1 + LFO (-1..1) sweeps 0 (mono) .. 2 (ultra-wide)
lfo_w -> st.width : 1.0

# Modulate balance (LFO is -1..1, balance input accepts -1..1)
lfo_b -> st.balance

# Connect to master output
st.out_l -> out.left
st.out_r -> out.right
-0.65 -> out.level   # two full-scale saws, widened: keep peaks under 0 dBFS
