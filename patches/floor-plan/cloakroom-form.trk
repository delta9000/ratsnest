# cloakroom-form.trk -- one row per bar (64), slewed in the patch.
track drums cva   # 1  kick, snare, hats
track bass  cva   # 2
track ep    cva   # 3
track pluck cva   # 4
track rim   cva   # 5
track room  cva   # 6  the small room's return
track main  cva   # 7

