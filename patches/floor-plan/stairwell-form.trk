# stairwell-form.trk -- one row per bar (88), slewed in the patch.
track drums cva   # 1  kick and hat
track bass  cva   # 2
track stab  cva   # 3  the dry blip
track send  cva   # 4  blip into the echo
track fb    cva   # 5  echo feedback
track throw cva   # 6  the figure's pluck
track shk   cva   # 7  shaker and rim
track verb  cva   # 8  the stairwell
track main  cva   # 9

pattern form 88
#    drums  bass   stab   send   fb     throw  shk    verb   main
00 | 0    | 0    | .5   | .5>  | .55  | 0    | .5   | .7   | 1     # intro: blip, rim, the stairs
04 | .8   | .    | .    | .    | .    | .    | .    | .    | .     # the kick enters
07 | .    | .    | .    | .9   | .    | .    | .    | .    | .
08 | 1    | .85  | .55  | .7   | .58  | 0    | .6   | .6   | .     # A
20 | .    | .    | .    | .7>  | .58> | .    | .    | .    | .
23 | .    | .    | .    | 1    | .7   | .    | .    | .    | .
24 | 1    | .9   | .6   | .75  | .6   | .8   | .9   | .6   | .     # B: chords move, the figure
48 | 0    | 0    | .4   | .35  | .72  | .55  | .5   | .8   | .     # dub: kit out, the echo runs long
55 | .    | .    | .    | .    | .76  | .    | .    | .    | .
56 | 1    | .95  | .6   | .8   | .6   | .85  | 1    | .6   | .     # C
76 | .    | .    | .    | .8>  | .6>  | .    | .    | .    | .
79 | .    | .    | .    | 1    | .72  | .    | .    | .    | .
80 | .8   | 0    | .5   | .9   | .74  | 0    | .5   | .8   | .     # outro
84 | .5   | .    | .    | .    | .    | .    | .    | .    | 1>
87 | 0    | .    | .    | .    | .    | .    | .    | .    | 0

order form
