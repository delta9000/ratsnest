# tide — tidal pulsing ambient
# 260s generative ambient: sub-bass heavy, very slow breathing. The
# defining feature is a 45 s "tidal" LFO pulsing the sub voices together;
# sparse modal bell hits; slow pad.
# Generated by humans, mistakes by claude.

# === METRONOME ===
clock = clock { bpm: 25 }
g8  = div { by: 6 }      # 14.4 s — main bell strikes
g12 = div { by: 9 }      # 21.6 s — high bell strikes
clock -> g8.in           # without this the dividers never tick — no strikes
clock -> g12.in

# === GLACIAL LFOs (incommensurate periods) ===
# LFO A is the tidal pulse at 45 s.
l1 = lfo { freq: 0.02222hz }   # 45 s  — TIDAL
l2 = lfo { freq: 0.01266hz }   # 79 s
l3 = lfo { freq: 0.00599hz }   # 167 s
l4 = lfo { freq: 0.00380hz }   # 263 s

# === GENERATIVE PITCH REGISTER ===
q1 = quant { scale: [0, 3, 5, 7, 10] }
t1 = turing { len: 8, prob: 0.10, seed: 71 }
clock -> t1.clock
t1 -> q1.in

# === THREE SUB VOICES, PULSED BY THE TIDAL LFO ===
sub_d1 = vco { freq: 36.71hz, wave: sine }
sub_a1 = vco { freq: 55hz,     wave: sine }
sub_d2 = vco { freq: 73.42hz,  wave: saw  }
sub_lp = ladder { cutoff: 200hz, res: 0.1 }

sub_vca_d1 = vca { gain: 0.0 }
sub_vca_a1 = vca { gain: 0.0 }
sub_vca_d2 = vca { gain: 0.0 }
sub_d1 -> sub_vca_d1.in
sub_a1 -> sub_vca_a1.in
sub_d2 -> sub_lp.in
sub_lp -> sub_vca_d2.in

# All three sub voices breath together with the 45 s tidal pulse.
0.5 -> sub_vca_d1.gain
l1 -> sub_vca_d1.gain : 0.5
0.45 -> sub_vca_a1.gain
l1 -> sub_vca_a1.gain : 0.45
0.4 -> sub_vca_d2.gain
l1 -> sub_vca_d2.gain : 0.4

# === SLOW HARMONIC PAD (long-sustain string drone at D2) ===
pad_str = string { seed: 29, freq: 73.42hz, structure: 0.25,
                   brightness: 0.45, damping: 0.95, position: 0.4 }
pad_env = adsr { attack: 8, decay: 40, sustain: 0.7, release: 30 }
pad_vca = vca { gain: 0.0 }
pad_str -> pad_vca.in
g8 -> pad_str.strike
1 -> pad_env.gate
pad_env -> pad_vca.gain

# === SPARSE MODAL BELLS ===
mod_d4 = modal { modes: 32, freq: 293.66hz, damping: 0.80, brightness: 0.60 }
mod_a4 = modal { modes: 32, freq: 440hz,    damping: 0.82, brightness: 0.62 }
b1 = bern { prob: 0.35, seed: 11 }
b2 = bern { prob: 0.25, seed: 19 }
g8  -> b1.gate
g12 -> b2.gate
b1 -> mod_d4.strike
b2 -> mod_a4.strike
q1 -> mod_d4.v_oct
q1 -> mod_a4.v_oct

# === MIX: voice bus ===
# Still sub-heavy (the tidal identity), but let the bells and pad through.
bus = mix { levels: [0.6, 0.55, 0.45, 0.6, 0.75, 0.75] }
sub_vca_d1 -> bus.in1
sub_vca_a1 -> bus.in2
sub_vca_d2 -> bus.in3
pad_vca -> bus.in4
mod_d4 -> bus.in5
mod_a4 -> bus.in6

# === FX: tempo-synced delay + long plate reverb ===
fx = mix { levels: [0.55, 0.55] }
rev = reverb { decay: 0.85, damp: 0.30, mix: 1, predelay: 0.025,
               bandwidth: 0.92, mod_rate: 0.3, mod_depth: 18 }
del = delay { time: 4.0s, feedback: 0.35, mix: 1, tone: 2000, slew: 0.3 }
bus.out_l -> fx.in1
bus.out_r -> fx.in2
fx.out_l -> rev.in_l
fx.out_r -> rev.in_r
fx.out_l -> del.in

# === MASTER ===
master = mix { levels: [1, 1, 0.55, 0.55, 0.5],
               pans: [-1, 1, -1, 1, 0] }
bus.out_l -> master.in1
bus.out_r -> master.in2
rev.out_l -> master.in3
rev.out_r -> master.in4
del.out -> master.in5

# === MASTERING — same shape as the album, with less low cut to preserve
# the sub-bass tidal weight. ===
dc = dcblock { cutoff: 15hz }
eq_m = eq { hp_freq: 30, low_freq: 100, low_gain: -0.2,
            mid1_freq: 500, mid1_gain: -0.3, mid1_q: 0.8,
            mid2_freq: 4000, mid2_gain: 0.4, mid2_q: 0.8,
            high_freq: 10000, high_gain: 0.3 }
comp_m = compressor { threshold: -18, ratio: 2.0, knee: 8,
                      attack: 0.05, release: 0.3, makeup: 2.6, mix: 1 }
field = stereo { width: 1.2, balance: 0 }
clip = clipper { mode: soft, threshold: -3, drive: 0.5, mix: 0.5 }
lim = limiter { threshold: -1.0, release: 0.15 }

master.out_l -> dc.in_l
master.out_r -> dc.in_r
dc.out_l -> eq_m.in_l
dc.out_r -> eq_m.in_r
eq_m.out_l -> comp_m.in_l
eq_m.out_r -> comp_m.in_r
comp_m.out_l -> field.in_l
comp_m.out_r -> field.in_r
field.out_l -> clip.in_l
field.out_r -> clip.in_r
clip.out_l -> lim.in_l
clip.out_r -> lim.in_r
lim.out_l -> out.left
lim.out_r -> out.right
-0.2 -> out.level
