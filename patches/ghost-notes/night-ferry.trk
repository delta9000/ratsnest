# night-ferry.trk -- "Night Ferry". 172 BPM, F# minor, 16 rows per bar,
# 128 bars. Liquid drum and bass: ratsnest's physical kit and piano, Surge
# on bass, pad and lead. Levels in night-ferry-form.trk.
#
#   F#m9 | Dmaj9 | Bm9 | C#7sus  (two bars each)
#
#   intro 16 | A 32 | break 16 | A2 48 | outro 16

track kick  note vel                    # 1  native kit kick; the duck trigger
track snare note vel                    # 2  native kit snare
track hat   note vel                    # 3  native kit hat
track ride  note vel                    # 4  native ride, 6-row free loop
track keys  note vel cva cvb cvd        # 5  physical piano, rolled
track pad   note vel cva cvb            # 6  Surge Classic supersaw: Osc 2/3 pitch per chord
track bass  note vel cva                # 7  Surge wavetable reese: cutoff per note
track lead  note vel cva                # 8  Surge Sine (feedback): cva = feedback per note

# ---- the break: two-step, ghost snares, ratchets ----
pattern brk 2x16 kick snare hat
1:00 | x .9       | .          | x .55
1:02 | .          | .          | x .35
1:03 | .          | x?.4 .2    | .
1:04 | .          | x@.03 .95  | x .4
1:06 | .          | .          | x .5
1:07 | .          | x?.5 .22   | x?.5 .25
1:08 | .          | .          | x .4
1:10 | x .75      | .          | x .5
1:11 | .          | x .25      | .
1:12 | .          | x@.05 1    | x .4
1:14 | .          | .          | x .5
1:15 | .          | x?.4 .2    | x?.4 .3
2:00 | x .85      | .          | x .55
2:02 | .          | .          | x .35
2:03 | .          | x@.2 .25   | .
2:04 | .          | x@.03 .95  | x .4
2:06 | x?.5 .5    | .          | x .5
2:07 | .          | .          | x*2 .3
2:08 | .          | x?.5 .2    | x .4
2:10 | x .75      | .          | x .5
2:12 | .          | x@.05 1    | x .4
2:13 | .          | x .3       | .
2:14 | .          | x?.6 .25   | x .5
2:15 | x?.4 .45   | x .35      | x*3 .3

pattern brk_fill 16 kick snare hat
00 | x .9       | .          | x .55
04 | .          | x@.03 .95  | .
06 | .          | x .4       | .
07 | x .6       | .          | .
08 | .          | x*2 .45    | .
10 | x .75      | x .5       | .
11 | .          | x .55      | .
12 | .          | x*3 .7     | .
13 | .          | x*2 .6     | .
14 | .          | x*4 .8     | .
15 | .          | x*4 .9     | .

pattern hats_in 2x16 hat
lane hat 3.5.4.5.3.5.4.6. 3.5.4.5.3.6.4.7.

pattern ride6 6 ride
00 | x .5
02 | x?.6 .3
04 | x@.2 .35

# ---- piano: rolled, re-hit softly late or by chance ----
pattern keys_a 8x16 keys
1:00 | A3 .5 Cs4 E4 Gs4         # F#m9
1:10 | x@.1 .3
2:04 | x?.5 .28
2:10 | x@.2 .35
3:00 | A3 .5 Cs4 E4 Fs4         # Dmaj9, rootless
3:10 | x@.1 .3
4:06 | x?.5 .3
5:00 | A3 .5 Cs4 D4 Fs4         # Bm9 (A C# D F#)
5:10 | x@.1 .3
6:04 | x?.5 .28
6:10 | x@.2 .35
7:00 | B3 .55 Cs4 E4 Fs4        # C#7sus
7:10 | x@.1 .32
8:00 | B3 .5 Cs4 F4 Gs4         # C#7 (E# as F)
8:08 | x?.6 .3
8:12 | x@.15 .38

pattern keys_brk 8x16 keys
1:00 | Fs3@.2 .45 A3 Cs4 Gs4
2:08 | x?.6 .25
3:00 | D3@.2 .42 A3 Cs4 E4
4:08 | x?.6 .25
5:00 | B2@.2 .42 A3 D4 Fs4
6:08 | x?.6 .25
7:00 | Cs3@.2 .48 B3 E4 Fs4
8:00 | Cs3@.3 .45 B3 F4 Gs4
8:14 | off

# ---- pad: supersaw chord in one note (+3 .714, +4 .786, +5 .857, +7 1, -2 .357, -5 .143) ----
pattern pad_a 8x16 pad
1:00 | Cs4 .5 .714 .357        # C# E B
3:00 | Cs4 .5 .857 .214        # C# F# A
5:00 | D4 .5 .714 .286         # D F B
7:00 | Cs4 .55 .857 1          # C# F# G#
8:00 | ~Cs4 .55 .786 1         # C# F G#

pattern pad_brk 8x16 pad
1:00 | Cs4 .45 .714 .357
3:00 | Cs4 .45 .857 .214
5:00 | D4 .45 .714 .286
7:00 | Cs4 .5 .857 1
8:00 | ~Cs4 .5 .786 1
8:14 | off

# ---- bass: reese, half-time phrases; cva = cutoff ----
pattern bass_a 8x16 bass
1:00 | Fs1 .8 .38
1:10 | Fs1 .6 .34
1:14 | off
2:00 | A1 .7 .4
2:06 | ~Gs1 .6
2:10 | Fs1 .6 .36
2:14 | off
3:00 | D1 .8 .38
3:10 | D2 .6 .44
3:12 | ~D1 .55
3:14 | off
4:00 | D1 .7 .36
4:08 | E1 .6 .4
4:10 | Fs1 .6
4:14 | off
5:00 | B0 .8 .38
5:10 | B1 .6 .44
5:12 | ~B0
5:14 | off
6:00 | D1 .7 .38
6:06 | ~Cs1 .6
6:10 | B0 .65 .36
6:14 | off
7:00 | Cs1 .85 .42
7:10 | Cs2 .6 .48
7:12 | ~Cs1
7:14 | off
8:00 | Cs1 .8 .42
8:06 | E1 .6 .45
8:08 | Fs1 .65 .48
8:10 | Gs1 .7 .5
8:12 | ~Cs2 .75 .55
8:15 | off

pattern bass_brk 8x16 bass
1:00 | Fs1 .6 .3
3:00 | D1 .6
5:00 | B0 .6
7:00 | Cs1 .65 .34
8:14 | off

# ---- lead: a sine with feedback; the album's figure, 5 b3 4 2 = C# A B G# ----
pattern lead_a 8x16 lead
1:00 | Cs5 .6 .3
1:06 | A4@.1 .5 .35
1:10 | B4 .55 .4
2:00 | Gs4 .65 .5
2:12 | off
3:00 | Fs4 .55 .3
3:04 | A4 .5
3:08 | Cs5 .6 .4
3:12 | E5 .65 .5
4:04 | ~D5 .5 .45
4:12 | off
5:00 | Fs5 .65 .35
5:06 | E5@.1 .5
5:10 | D5 .55 .4
6:00 | Cs5 .6 .5
6:06 | B4 .5
6:10 | A4 .55 .55
6:14 | off
7:00 | B4 .6 .3
7:04 | Cs5 .5
7:08 | E5 .6 .4
7:12 | Fs5 .65 .5
8:04 | ~F5 .6 .6
8:12 | off

pattern lead_a2 8x16 lead
1:00 | Fs5 .6 .3
1:04 | E5 .5
1:06 | Cs5 .55 .4
1:10 | A4 .5
2:00 | B4 .6 .5
2:08 | Cs5@.1 .5
2:12 | off
3:00 | A5 .65 .35
3:06 | Fs5@.1 .5
3:10 | E5 .55 .45
4:00 | D5 .6 .55
4:08 | E5 .5
4:12 | off
5:00 | Cs5 .6 .3
5:06 | A4@.1 .5 .35
5:10 | B4 .55 .4
6:00 | Gs4 .65 .5
6:12 | off
7:00 | Gs5 .6 .35
7:04 | Fs5 .5
7:06 | E5 .55 .45
7:10 | Cs5 .5
8:00 | F5 .65 .6
8:08 | ~Gs5 .6 .5
8:14 | off

section intro  keys_a+pad_a+hats_in+ride6~
section a      keys_a+pad_a+bass_a+brk+ride6~
section af     keys_a+pad_a+bass_a+brk+ride6~+brk_fill@112
section la     keys_a+pad_a+bass_a+brk+ride6~+lead_a
section laf    keys_a+pad_a+bass_a+brk+ride6~+lead_a+brk_fill@112
section bk     keys_brk+pad_brk+bass_brk+ride6~
section a2     keys_a+pad_a+bass_a+brk+ride6~+lead_a2
section a2f    keys_a+pad_a+bass_a+brk+ride6~+lead_a2+brk_fill@112
section out    keys_brk+pad_a+hats_in+ride6~

order intro*2 a af la laf bk*2 a2 laf a2f la a2 a2f out*2
