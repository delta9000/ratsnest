# concrete-garden -- broken beat. 96 BPM, D dorian, 72 bars (3:00).
# Track 5 of "Ghost Notes".
#
# Ratsnest plays the band: the physical kit (modal kick, snare, hats, toms)
# on a written two-bar break with flams, ghost snares and ratchets, a
# 9-row tom figure that crosses the bar line, a 6-op FM electric piano
# comping four-note voicings, and the reese bass.
# Surge sings and leads:
#   lead  the Alias oscillator (a ramp read through wrap, mask and a
#         bitcrusher). Wrap and mask are locked per note, so the timbre
#         moves with the phrase; the form lane lowers the bit depth across
#         each section. Through Surge's Chorus and a ratsnest echo.
#   vox   Twist's Vowels/Speech engine as a choir: one long slurred line,
#         every note a different segment (vowel or word), through Surge's
#         Ensemble and Reverb 2.
# Velocity: Surge parts set "A Velocity > VCA Gain=-48 dB" and take vel x 0.2.

t    = transport { bpm: 96, division: 4, bars: 4, swing: 0.08 }
song = tracker { file: "concrete-garden.trk", seed: 17 }
form = tracker { file: "concrete-garden-form.trk" }
t.clock -> song.clock
t.bar   -> form.clock

drums_lvl = func { rise: 0.3, fall: 0.3 }
tom_lvl   = func { rise: 1, fall: 1 }
ep_lvl    = func { rise: 1, fall: 1 }
bass_lvl  = func { rise: 0.3, fall: 0.6 }
lead_lvl  = func { rise: 1, fall: 1 }
vox_lvl   = func { rise: 2, fall: 2 }
crush_lvl = func { rise: 6, fall: 2 }
verb_lvl  = func { rise: 2, fall: 2 }
main_lvl  = func { rise: 0.5, fall: 0.5 }
form.cva1 -> drums_lvl.in
form.cva2 -> tom_lvl.in
form.cva3 -> ep_lvl.in
form.cva4 -> bass_lvl.in
form.cva5 -> lead_lvl.in
form.cva6 -> vox_lvl.in
form.cva7 -> crush_lvl.in
form.cva8 -> verb_lvl.in
form.cva9 -> main_lvl.in

duck = sub { file: "../lib/duck.sub", depth_db: -5, release: 0.2, curve: exp }
song.gate1 -> duck.trig

# ---- kit: ratsnest's physical drums ----
kick = sub { file: "../lib/kit/kick.sub", tune: 50hz, decay: 0.4, bend: 2.2 }
song.gate1 -> kick.trig
song.vel1  -> kick.accent
kick_s = sub { file: "../lib/strip.sub", gain: 1.15 }
kick -> kick_s.in
drums_lvl -> kick_s.level

snare = sub { file: "../lib/kit/snare.sub", tune: 200hz, decay: 0.32, snap: 0.6 }
song.gate2 -> snare.trig
song.vel2  -> snare.accent
snare_s = sub { file: "../lib/strip.sub", gain: 1.5, send_gain: 0.35, pos: 0.05 }
snare -> snare_s.in
drums_lvl -> snare_s.level

hat = sub { file: "../lib/kit/hat_model.sub", decay: 0.05s, tone: 10khz }
song.gate3 -> hat.trig
song.vel3  -> hat.accent
hat_s = sub { file: "../lib/strip.sub", gain: 1.0, send_gain: 0.15, pos: 0.3 }
hat -> hat_s.in
drums_lvl -> hat_s.level

tom = sub { file: "../lib/kit/tom.sub", tune: 130hz, decay: 0.5, bend: 0.25 }
song.gate4 -> tom.trig
song.vel4  -> tom.accent
tpan = lfo { freq: 0.083hz }
tom_s = sub { file: "../lib/strip.sub", gain: 0.35, send_gain: 0.4 }
tom -> tom_s.in
tpan -> tom_s.pan : 0.35
tom_lvl -> tom_s.level

# ---- EP: native 6-op FM, four voices ----
ec = chord { n: 4, strum: 0.008, vel: 0 }
song.gate5 -> ec.gate
song.vel5  -> ec.vel
song.voct5 -> ec.p1
song.cva5  -> ec.p2
song.cvb5  -> ec.p3
song.cvd5  -> ec.p4
ep = voice { notes: ec }
ep.v = fm { algo: dual, ratios: [1, 1, 7, 1, 14, 1], levels: [.5, .3, .1, .45, .1, .15],
            t2: [.5, .07, .06, .45, .06, .09], l2: [.55, .25, .2, .5, .2, .25],
            l3: [.18, 0, 0, .15, 0, 0], fb: [0, 0, 0, 0, .23, 0], t4: [.25, .2, .2, .25, .2, .2],
            vel_sens: [.6, .8, .9, .6, .9, .8], curve: log }
ec.gate -> ep.v.gate
ec.voct -> ep.v.v_oct
ec.vel  -> ep.v.vel
trem = lfo { freq: 4.7hz }
ep_ch = chorus {}
ep.v -> ep_ch.in_l : 0.3
ep.v -> ep_ch.in_r : 0.3
ep_s = sub { file: "../lib/strip.sub", gain: 0.8, send_gain: 0.3 }
ep_ch.out_l -> ep_s.in_l
ep_ch.out_r -> ep_s.in_r
trem -> ep_s.pan : 0.25
ep_lvl -> ep_s.level
duck -> ep_s.duck

# ---- bass: native reese ----
bass = sub { file: "../lib/reese.sub", saw_cut: 300, saw_drive: 0.6 }
song.voct6 -> bass.voct
1 -> bass.level
bgate = adsr { attack: 0.004, decay: 0.3, sustain: 0.85, release: 0.08 }
song.gate6 -> bgate.gate
bvca = vca { gain: 0 }
bass.main -> bvca.in
bgate -> bvca.cv
bass_s = sub { file: "../lib/strip.sub", gain: 0.45 }
bvca -> bass_s.in
bass_lvl -> bass_s.level
duck -> bass_s.duck

# ---- lead: Surge Alias, wrap and mask per note ----
lead = plugin { file: "Surge XT",
  set: ["A Velocity > VCA Gain=-48 dB", "A Osc 1 Type=Alias", "A Osc 1 Shape=Ramp",
        "A Osc 1 Unison Voices=3 voices", "A Osc 1 Unison Detune=14 cents",
        "A Play Mode=Mono (Fingered Portamento)", "A Portamento=55 ms",
        "A Filter 1 Type=LP 12 dB", "A Filter 1 Cutoff=4200 Hz", "A Filter 1 Resonance=20 %",
        "A Amp EG Attack=4 ms", "A Amp EG Decay=600 ms", "A Amp EG Sustain=70 %", "A Amp EG Release=250 ms",
        "FX A1 FX Type=Chorus", "FX A1 Output - Mix=40 %"],
  params: ["A Osc 1 Wrap", "A Osc 1 Mask", "A Osc 1 Bitcrush"] }
song.gate7 -> lead.gate
song.voct7 -> lead.voct
song.vel7  -> lead.vel : 0.2
song.cva7  -> lead.p1
wob = lfo { freq: 0.17hz }
wob -> lead.p1 : 0.05
song.cvb7  -> lead.p2
crush_lvl  -> lead.p3
lead_s = sub { file: "../lib/strip.sub", gain: 4.5, send_gain: 0.45, pos: -0.12 }
lead.out_l -> lead_s.in_l
lead.out_r -> lead_s.in_r
lead_lvl -> lead_s.level
dl = tempo { bpm: 96, beats: 0.75 }
dr = tempo { bpm: 96, beats: 0.5 }
echo_l = delay { time: 0ms, feedback: 0.4, tone: 2600, mix: 1 }
echo_r = delay { time: 0ms, feedback: 0.36, tone: 2200, mix: 1 }
dl.seconds -> echo_l.time
dr.seconds -> echo_r.time
lead_s.fx -> echo_l.in
echo_l -> echo_r.in : 0.5

# ---- vox: Twist Vowels/Speech ----
vox = plugin { file: "Surge XT",
  set: ["A Velocity > VCA Gain=-48 dB", "A Osc 1 Type=Twist", "A Osc 1 Engine=Vowels/Speech",
        "A Play Mode=Mono (Fingered Portamento)", "A Portamento=180 ms",
        "A Filter 1 Type=LP 12 dB", "A Filter 1 Cutoff=5000 Hz",
        "A Amp EG Attack=500 ms", "A Amp EG Sustain=100 %", "A Amp EG Release=1.5 s",
        "FX A1 FX Type=Ensemble", "FX A1 Output - Mix=70 %",
        "FX A2 FX Type=Reverb 2", "FX A2 Reverb - Decay Time=4 s", "FX A2 Output - Mix=40 %"],
  params: ["627352117", "627352115", "627352116"] }
song.gate8 -> vox.gate
song.voct8 -> vox.voct
song.vel8  -> vox.vel : 0.2
song.cva8  -> vox.p1
song.cvb8  -> vox.p2
species = lfo { freq: 0.05hz }
0.5 -> vox.p3
species -> vox.p3 : 0.3
vox_s = sub { file: "../lib/strip.sub", gain: 4.5, send_gain: 0.4, pos: 0.1 }
vox.out_l -> vox_s.in_l
vox.out_r -> vox_s.in_r
vox_lvl -> vox_s.level

# ---- space ----
room = reverb { decay: 0.7, damp: 0.5, mix: 1, predelay: 0.02 }
snare_s.fx -> room.in_l
hat_s.fx   -> room.in_r
tom_s.fx   -> room.in_l
ep_s.fx    -> room.in_r
vox_s.fx   -> room.in_l
lead_s.fx  -> room.in_r : 0.5
echo_r     -> room.in_l : 0.3
room_hl = svf { cutoff: 250, res: 0 }
room_hr = svf { cutoff: 250, res: 0 }
room.out_l -> room_hl.in
room.out_r -> room_hr.in
room_s = sub { file: "../lib/strip.sub", gain: 2.0 }
room_hl.hp -> room_s.in_l
room_hr.hp -> room_s.in_r
verb_lvl -> room_s.level

master = sub { file: "../lib/master-chain.sub", ceiling: -1.3, true_peak: on, key_bus: 0.3 }
6 -> master.makeup
kick_s.l  -> master.in_l
kick_s.r  -> master.in_r
snare_s.l -> master.in_l
snare_s.r -> master.in_r
hat_s.l   -> master.in_l
hat_s.r   -> master.in_r
tom_s.l   -> master.in_l
tom_s.r   -> master.in_r
ep_s.l    -> master.in_l
ep_s.r    -> master.in_r
bass_s.l  -> master.in_l
bass_s.r  -> master.in_r
lead_s.l  -> master.in_l
lead_s.r  -> master.in_r
echo_l    -> master.in_l : 0.35
echo_r    -> master.in_r : 0.35
vox_s.l   -> master.in_l
vox_s.r   -> master.in_r
room_s.l  -> master.in_l
room_s.r  -> master.in_r
fade_l = vca { gain: 0 }
fade_r = vca { gain: 0 }
master.l -> fade_l.in
master.r -> fade_r.in
main_lvl -> fade_l.cv
main_lvl -> fade_r.cv
fade_l -> out.left
fade_r -> out.right
