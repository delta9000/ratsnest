# concrete-garden-form.trk -- one row per bar (72), slewed in the patch.
track drums cva   # 1  kick, snare, hats
track tom   cva   # 2
track ep    cva   # 3
track bass  cva   # 4
track lead  cva   # 5
track vox   cva   # 6
track crush cva   # 7  lead bitcrush (Surge normalized: 1 = 8 bits .. lower = fewer)
track verb  cva   # 8
track main  cva   # 9

