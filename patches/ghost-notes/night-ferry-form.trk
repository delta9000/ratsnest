# night-ferry-form.trk -- one row per bar (128), slewed in the patch.
track drums cva   # 1  kick, snare
track hats  cva   # 2  hats, ride
track keys  cva   # 3
track pad   cva   # 4
track pcut  cva   # 5  pad cutoff (Surge normalized)
track bass  cva   # 6
track bcut  cva   # 7  bass cutoff offset (Surge normalized, sums onto the locks)
track lead  cva   # 8
track rain  cva   # 9
track verb  cva   # 10
track main  cva   # 11

