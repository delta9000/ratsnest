# paper-lanterns.trk -- "Paper Lanterns". 86 BPM, C minor, 16 rows per bar,
# 64 bars. Levels and filter moves are in paper-lanterns-form.trk.
#
# A: Cm9  Abmaj7  Fm9  G7b9        B: Ebmaj9  Dm7b5  Cm9  G7b9b13
#
#   intro 8 | A 16 | B 8 | A2 16 (lead) | break 8 | outro 8

track kk    note len 1                  # 1  native kick under Twist; the duck trigger
track kit   note vel cva cvb cvd        # 2  Surge Twist kit: engine, knob, decay per row
track rim   note vel                    # 3  native rim, 7-row free loop
track shk   note vel                    # 4  native shaker, 5-row free loop
track keys  note vel cva cvb cvd        # 5  physical piano, four-note voicings
track pad   note vel cva cvb            # 6  Surge wavetable: Osc 2 / Osc 3 pitch per chord
track bass  note vel cva                # 7  Surge Classic, mono, cutoff per step
track lead  note vel cva cvd            # 8  Surge FM2 tine: FM depth, echo throw per note

# ---- piano: four-note rootless voicings; re-hits are quieter, late, by chance ----
pattern keys_a 4x16 keys
1:00 | G3 .5 Bb3 D4 Eb4          # Cm9
1:07 | x@.12 .28
1:10 | x?.6 .36
1:14 | x@.2 .22
2:00 | Ab3 .55 C4 Eb4 G4        # Abmaj7
2:06 | x@.15 .32
2:11 | x?.5 .3
3:00 | G3 .5 Ab3 C4 Eb4         # Fm9
3:07 | x@.1 .3
3:10 | x?.55 .38
3:15 | x?.4 .2
4:00 | F3 .58 B3 D4 Ab4         # G7b9
4:06 | x .36
4:10 | x@.2 .42
4:14 | off

pattern keys_b 4x16 keys
1:00 | G3 .5 Bb3 D4 F4           # Ebmaj9
1:07 | x@.12 .3
1:10 | x?.6 .34
2:00 | Ab3 .52 C4 D4 F4         # Dm7b5
2:06 | x@.15 .3
2:11 | x?.5 .32
2:14 | x@.1 .22
3:00 | G3 .5 Bb3 D4 Eb4         # Cm9
3:07 | x@.1 .3
3:10 | x?.55 .36
4:00 | F3 .6 B3 Eb4 Ab4         # G7b9b13
4:04 | x?.5 .3
4:08 | x@.15 .44
4:12 | x?.6 .3
4:15 | off

# the break: the same changes, sparser and softer, every chord rolled late
pattern keys_brk 4x16 keys
1:00 | G3@.2 .42 Bb3 D4 F4
1:10 | x?.5 .25
2:00 | Ab3@.25 .4 C4 D4 F4
2:12 | x?.5 .24
3:00 | G3@.2 .4 Bb3 D4 Eb4
3:10 | x?.5 .25
4:00 | F3@.3 .48 B3 Eb4 Ab4
4:12 | off

# ---- pad: one note, Osc 2 and Osc 3 pitch make the chord (+3 .714, +4 .786, -1 .429, -3 .286, +6 .929) ----
pattern pad_a 4x16 pad
1:00 | Eb4 .5 .429 .786          # Eb D G
2:00 | Eb4 .5 .786 .286          # Eb G C
3:00 | C4 .5 .714 1              # C Eb G
4:00 | B3 .55 .714 .929          # B D F

pattern pad_b 4x16 pad
1:00 | Bb3 .5 .786 1             # Bb D F
2:00 | C4 .5 .643 .857           # C D F
3:00 | Eb4 .5 .429 .786          # Eb D G
4:00 | B3 .55 .786 .929          # B Eb F

# ---- bass: roots, ghost re-hits, octave pops and slides; cva = cutoff ----
pattern bass_a 4x16 bass
1:00 | C2 .8 .36
1:06 | off
1:07 | C2@.1 .35 .3
1:10 | G1 .6 .34
1:12 | off
1:14 | Bb1 .5
2:00 | Ab1 .8 .38
2:06 | off
2:08 | Ab2 .5 .48
2:09 | ~Ab1
2:12 | Eb2 .6 .36
2:14 | off
3:00 | F1 .8 .35
3:06 | off
3:07 | F1@.1 .35 .3
3:10 | C2 .6 .35
3:12 | Eb2 .5 .44
3:13 | off
3:14 | F2 .55 .4
4:00 | G1 .85 .4
4:04 | off
4:06 | G1 .5 .32
4:08 | B1 .6 .42
4:10 | D2 .55
4:12 | F2 .6 .5
4:14 | ~G2 .5
4:15 | off

pattern bass_b 4x16 bass
1:00 | Eb2 .8 .36
1:06 | off
1:07 | Eb2@.1 .35 .3
1:10 | Bb1 .6 .34
1:12 | off
1:14 | D2 .55 .4
2:00 | D2 .8 .38
2:06 | off
2:08 | Ab1 .6 .34
2:10 | off
2:12 | F2 .55 .46
2:14 | ~D2 .5
3:00 | C2 .8 .36
3:06 | off
3:07 | C2@.1 .35 .3
3:10 | G1 .6 .34
3:12 | Bb1 .55
3:13 | off
3:14 | C2 .5 .4
4:00 | G1 .85 .4
4:06 | off
4:08 | G2 .5 .5
4:09 | ~G1
4:12 | B1 .6 .42
4:14 | D2 .55
4:15 | off

pattern bass_brk 4x16 bass
1:00 | Eb2 .6 .3
2:00 | D2 .6
3:00 | C2 .6
4:00 | G1 .65 .34
4:12 | off

# ---- kit: kick F1 .863, snare C4 .929, hat A6 .995; every hit writes its engine ----
pattern kit 2x16 kit kk
1:00 | F1 .75 .863 .55 .5       | x
1:02 | A6 .45 .995 .5 .12
1:04 | C4@.08 .9 .929 .6 .4
1:06 | A6 .5 .995 .5 .14
1:07 | F1?.4 .35 .863 .5 .35
1:08 | A6 .38 .995 .45 .12
1:10 | F1 .7 .863 .55 .5        | x
1:11 | A6?.5 .25 .995 .4 .1
1:12 | C4@.1 .95 .929 .62 .42
1:14 | A6 .5 .995 .5 .3
2:00 | F1 .75 .863 .55 .5       | x
2:02 | A6 .4 .995 .5 .12
2:03 | F1@.05 .45 .863 .5 .35
2:04 | C4@.08 .9 .929 .6 .4
2:06 | A6 .5 .995 .5 .14
2:08 | A6 .35 .995 .45 .12
2:09 | C4?.5 .3 .929 .4 .2
2:10 | F1 .65 .863 .55 .5       | x
2:12 | C4@.12 1 .929 .62 .45
2:13 | A6 .3 .995 .4 .1
2:14 | A6*2 .45 .995 .5 .12
2:15 | C4?.4 .3 .929 .4 .2

# intro/outro kit: kick on the one, hats breathing, a rim-snare on 4
pattern kit_in 2x16 kit kk
1:00 | F1 .55 .863 .6 .55       | x
1:04 | A6 .35 .995 .5 .1
1:06 | A6 .5 .995 .5 .28
1:10 | A6?.6 .3 .995 .45 .12
1:12 | C4@.1 .45 .929 .35 .2
1:14 | A6 .45 .995 .5 .3
2:00 | F1 .5 .863 .6 .55        | x
2:06 | A6 .5 .995 .5 .28
2:10 | F1?.5 .4 .863 .55 .4
2:12 | C4@.12 .5 .929 .35 .2
2:14 | A6 .5 .995 .5 .5

# a bar's fill, laid over the last bar of a four-bar step
pattern fill 16 kit kk
00 | F1 .75 .863 .55 .5        | x
02 | A6 .4 .995 .5 .12
04 | C4@.08 .9 .929 .6 .4
06 | C4 .4 .929 .45 .2
07 | F1 .55 .863 .5 .35
09 | C4*2 .5 .929 .5 .25
10 | F1 .6 .863 .55 .45        | x
11 | C4@.1 .6 .929 .55 .3
12 | C4@.06 .95 .929 .62 .45
13 | C4*3 .55 .929 .5 .25
14 | F1 .6 .863 .7 .3
15 | C4*4 .7 .929 .55 .3

# ghosts: rim on 7 rows, shaker on 5, against the 16-row bar
pattern rim7 7 rim
00 | x .5
03 | x?.5 .28
05 | x@.3 .22

pattern shk5 5 shk
00 | x .5
02 | x?.6 .3
03 | x@.2 .36

# ---- lead: FM2 tine; cva = FM depth, cvd = echo throw. The album's figure (5 b3 4 2) opens it ----
pattern lead_a1 4x16 lead
1:00 | G4 .6 .4 .15
1:03 | Eb4@.1 .45
1:06 | F4 .5
1:08 | D4 .65 .45 .7
1:12 | off
2:02 | C5@.05 .5 .4 .15
2:04 | Bb4 .45
2:06 | G4 .55
2:10 | Eb4 .5
2:14 | off
3:00 | Ab4 .6 .5 .2
3:04 | G4 .45
3:07 | F4@.1 .5
3:10 | Eb4 .55
3:12 | C4 .5 .4 .6
3:15 | off
4:00 | D4 .55 .4 .15
4:03 | F4 .45
4:06 | Ab4 .55 .5
4:08 | B4 .6 .55 .5
4:11 | off

pattern lead_a2 4x16 lead
1:00 | Eb5 .6 .4 .2
1:02 | D5 .5
1:04 | C5 .55
1:07 | G4@.1 .5 .35 .7
1:11 | off
2:00 | G4 .5 .4 .15
2:04 | Bb4 .5
2:06 | C5 .55
2:08 | Eb5 .6 .5
2:12 | D5 .5
2:14 | off
3:00 | C5 .6 .45 .2
3:03 | Ab4@.1 .5
3:06 | G4 .5
3:08 | F4 .55
3:10 | Eb4 .5 .4 .6
3:14 | off
4:00 | G4 .6 .5 .15
4:04 | F4 .5
4:06 | D4 .55
4:08 | B3 .6 .45 .8
4:12 | off

pattern lead_b 4x16 lead
1:00 | D5 .55 .4 .2
1:04 | Bb4 .5
1:06 | G4 .5
1:10 | F4 .55 .45 .6
1:14 | off
2:00 | Ab4 .55 .4 .2
2:03 | F4@.1 .45
2:06 | D4 .5
2:08 | C5 .6 .5 .6
2:12 | off
3:00 | G4 .6 .4 .2
3:03 | Eb4@.1 .5
3:06 | F4 .5
3:08 | D4 .6 .45 .8
3:12 | off
4:04 | B4 .55 .5 .2
4:06 | Ab4 .5
4:08 | F4 .55
4:10 | Eb4 .5
4:12 | D4 .6 .5 .7
4:15 | off

# the break: the figure alone, slow, every note thrown
pattern lead_brk 4x16 lead
1:00 | G4 .45 .3 .9
1:08 | Eb4@.2 .4
2:00 | F4 .45
2:08 | D4@.2 .5 .35 1
2:14 | off
3:08 | G4 .4 .3 .8
4:00 | Eb4@.1 .4
4:06 | F4 .4
4:10 | D4 .45 .35 1
4:14 | off

section intro  keys_a+pad_a+kit_in+shk5~
section a      keys_a+pad_a+bass_a+kit+rim7~+shk5~
section af     keys_a+pad_a+bass_a+kit+rim7~+shk5~+fill@48
section b      keys_b+pad_b+bass_b+kit+lead_b+rim7~+shk5~
section bf     keys_b+pad_b+bass_b+kit+lead_b+rim7~+shk5~+fill@48
section a2     keys_a+pad_a+bass_a+kit+lead_a1+rim7~+shk5~
section a2f    keys_a+pad_a+bass_a+kit+lead_a2+rim7~+shk5~+fill@48
section brk    keys_brk+pad_b+bass_brk+lead_brk+rim7~
section out    keys_a+pad_a+bass_a+kit_in+shk5~

order intro*2 a af a af b bf a2 a2f a2 a2f brk*2 out*2
