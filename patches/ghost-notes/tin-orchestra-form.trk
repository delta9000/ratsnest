# tin-orchestra-form.trk -- one row per bar (56), slewed in the patch.
# Column 1 is the tempo, written as (BPM - 76) / 100: 0 = 76, .32 = 108.
track bpm     cva   # 1
track saron   cva   # 2
track kenong  cva   # 3  kenong and gong
track bonang  cva   # 4  polos and sangsih
track bright  cva   # 5  bonang brightness (Surge normalized)
track kick    cva   # 6  kick and shaker
track drone   cva   # 7
track verb    cva   # 8
track main    cva   # 9

