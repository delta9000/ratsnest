# switchyard-form.trk -- one row per bar (88), slewed in the patch.
track kick  cva   # 1
track perc  cva   # 2  Twist perc, clap, open hat
track bass  cva   # 3
track bcut  cva   # 4  bass cutoff offset (Surge normalized, sums onto the locks)
track stab  cva   # 5
track scut  cva   # 6  stab cutoff (Surge normalized)
track blp   cva   # 7  both bleeps
track echo  cva   # 8  dub echo feedback push
track rise  cva   # 9
track verb  cva   # 10
track main  cva   # 11

