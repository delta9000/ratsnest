# harbor — bell-focused ambient
# 180s generative ambient: multiple modal resonators at different pitches
# strike in generative pattern; long shimmer reverb; celestial, slow.
# Generated by humans, mistakes by claude.

# === METRONOME ===
clock = clock { bpm: 30 }
g8  = div { by: 6 }     # 12.0 s — main bell strikes
g12 = div { by: 8 }     # 16.0 s — high bell strikes
clock -> g8.in          # without this the dividers never tick — no strikes
clock -> g12.in

# === GLACIAL LFOs (incommensurate periods) ===
l1 = lfo { freq: 0.01493hz }   # 67 s
l2 = lfo { freq: 0.00763hz }   # 131 s
l3 = lfo { freq: 0.00503hz }   # 199 s
l4 = lfo { freq: 0.00322hz }   # 311 s

# === GENERATIVE PITCH REGISTER ===
q1 = quant { scale: [0, 3, 5, 7, 10] }
t1 = turing { len: 8, prob: 0.15, seed: 31 }
clock -> t1.clock
t1 -> q1.in

# === FOUR MODAL BELLS (A3 / D4 / F#4 / A4), each with its own bern gate ===
# Long damping = long celestial ring (higher value rings longer); a touch
# of extra brightness gives the upper partials that carry the "shimmer".
mod_a3  = modal { modes: 32, freq: 220hz,    damping: 0.82, brightness: 0.60 }
mod_d4  = modal { modes: 32, freq: 293.66hz, damping: 0.80, brightness: 0.62 }
mod_f4  = modal { modes: 32, freq: 369.99hz, damping: 0.85, brightness: 0.64 }
mod_a4  = modal { modes: 32, freq: 440hz,    damping: 0.85, brightness: 0.66 }

b1 = bern { prob: 0.55, seed: 5 }
b2 = bern { prob: 0.45, seed: 9 }
b3 = bern { prob: 0.40, seed: 13 }
b4 = bern { prob: 0.35, seed: 21 }
g8  -> b1.gate
g8  -> b2.gate
g12 -> b3.gate
g12 -> b4.gate
b1 -> mod_a3.strike
b2 -> mod_d4.strike
b3 -> mod_f4.strike
b4 -> mod_a4.strike

# Quant drifts each bell's pitch through the scale. Depth 1.0: the quantizer
# output is v/oct, so scaling it detunes the temperament — feed it whole.
q1 -> mod_a3.v_oct
q1 -> mod_d4.v_oct
q1 -> mod_f4.v_oct
q1 -> mod_a4.v_oct

# === SLOW HARMONIC PAD (long-sustain string drone at A2) ===
pad_str = string { seed: 19, freq: 110hz, structure: 0.20,
                   brightness: 0.4, damping: 0.97, position: 0.5 }
pad_env = adsr { attack: 6, decay: 30, sustain: 0.6, release: 20 }
pad_vca = vca { gain: 0.0 }
pad_str -> pad_vca.in
g8 -> pad_str.strike
1 -> pad_env.gate
pad_env -> pad_vca.gain

# === SUB: D1 sine, slow tremolo ===
sub_osc = vco { freq: 36.71hz, wave: sine }
sub_vca = vca { gain: 0.0 }
sub_osc -> sub_vca.in
0.15 -> sub_vca.gain
l2 -> sub_vca.gain : 0.10

# === VERY SPARSE SINE EVENTS ===
ev_pulse = bern { prob: 0.25, seed: 41 }
ev_env = adsr { attack: 2, decay: 6, sustain: 0.3, release: 8 }
ev_vca = vca { gain: 0.0 }
ev_osc = vco { freq: 220hz, wave: sine }
g12 -> ev_pulse.gate
ev_pulse -> ev_env.gate
ev_env -> ev_vca.gain
ev_osc -> ev_vca.in
q1 -> ev_osc.v_oct

# === MIX: voice bus ===
# Bells now ring long, so trim their bus level and pull the sub down out of
# the way — the sub was a continuous 36 Hz bed drowning the sparse bells.
bus = mix { levels: [0.9, 0.9, 0.9, 0.9, 0.7, 0.45, 0.7] }
mod_a3 -> bus.in1
mod_d4 -> bus.in2
mod_f4 -> bus.in3
mod_a4 -> bus.in4
pad_vca -> bus.in5
sub_vca -> bus.in6
ev_vca -> bus.in7

# === FX: tempo-synced delay + long shimmer reverb ===
fx = mix { levels: [0.6, 0.6] }
rev = reverb { decay: 0.85, damp: 0.32, mix: 1, predelay: 0.025,
               bandwidth: 0.92, mod_rate: 0.6, mod_depth: 35 }
del = delay { time: 4.0s, feedback: 0.4, mix: 1, tone: 2400, slew: 0.3 }
bus.out_l -> fx.in1
bus.out_r -> fx.in2
fx.out_l -> rev.in_l
fx.out_r -> rev.in_r
fx.out_l -> del.in

# === MASTER ===
master = mix { levels: [1, 1, 0.9, 0.9, 0.7],
               pans: [-1, 1, -1, 1, 0] }
bus.out_l -> master.in1
bus.out_r -> master.in2
rev.out_l -> master.in3
rev.out_r -> master.in4
del.out -> master.in5

# === MASTERING ===
dc = dcblock { cutoff: 15hz }
eq_m = eq { hp_freq: 30, low_freq: 100, low_gain: -0.4,
            mid1_freq: 500, mid1_gain: -0.3, mid1_q: 0.8,
            mid2_freq: 4000, mid2_gain: 0.4, mid2_q: 0.8,
            high_freq: 10000, high_gain: 0.3 }
comp_m = compressor { threshold: -6, ratio: 4.0, knee: 8,
                      attack: 0.01, release: 0.2, makeup: 4.0, mix: 1 }
field = stereo { width: 1.2, balance: 0 }
clip = clipper { mode: soft, threshold: -3, drive: 0.5, mix: 0.5 }
lim = limiter { threshold: -1.0, release: 0.15 }

master.out_l -> dc.in_l
master.out_r -> dc.in_r
dc.out_l -> eq_m.in_l
dc.out_r -> eq_m.in_r
eq_m.out_l -> comp_m.in_l
eq_m.out_r -> comp_m.in_r
comp_m.out_l -> field.in_l
comp_m.out_r -> field.in_r
field.out_l -> clip.in_l
field.out_r -> clip.in_r
clip.out_l -> lim.in_l
clip.out_r -> lim.in_r
lim.out_l -> out.left
lim.out_r -> out.right
-0.2 -> out.level
