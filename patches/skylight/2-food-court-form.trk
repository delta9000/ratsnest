# 2-food-court-form.trk -- one row per bar (68 bars + 4 of tail); '>' ramps to the next value.
track drums cva    # 1  kick + clap/rim
track hats  cva    # 2
track bass  cva    # 3
track keys  cva    # 4  e-piano
track clav  cva    # 5
track chops cva    # 6  vocal chops
track verb  cva    # 7  room return
track main  cva    # 8  master fade
track tape  cva    # 9  share of the music sent through the tape (0..1)
track pa    note   # 10 gate: pa-foodcourt (slowed ~9.7 s = 3.6 bars)
track teen  note   # 11 gate: iv-teen (slowed ~6.5 s = 2.4 bars)

