# 1-opening-hour.trk -- "Opening Hour", skylight track 1, 96 BPM, 16 rows per bar.
# intro 4 | A 8 | B 8 (jingle) | A2 8 (+ bells) | break 8 | A3 8 | B2 8 | B3 8 | outro 6 = 66 bars
# Gmaj9 | Em9 | Cmaj9 | D6/9, one bar each, rootless voicings on the e-piano,
# the roots on the bass. Written in G; track 1 is the tape at full speed.

track kick  note              # 1
track snare note vel          # 2  snare + clap on 2 and 4
track hat   note vel          # 3
track keys  note cva cvb cvd  # 4  four e-piano tones
track root  note              # 5  chord roots, bass register (not played)
track bass  note vel from root    # 6
track lead  note vel          # 7  trumpet (two CC0 samples)
track bell  note vel from keys    # 8  FM bells: the PA chime and the arps

# ---------------- harmony ----------------
pattern harm 4x16 keys root
1:00 | B3  D4  Fs4 A4  | G1      # Gmaj9 (rootless)
2:00 | G3  B3  D4  Fs4 | E1      # Em9
3:00 | E3  G3  B3  D4  | C2      # Cmaj9
4:00 | Fs3 A3  B3  E4  | D2      # D6/9

pattern harm_out 6x16 keys root
1:00 | B3  D4  Fs4 A4  | G1
2:00 | G3  B3  D4  Fs4 | E1
3:00 | E3  G3  B3  D4  | C2
4:00 | Fs3 A3  B3  E4  | D2
5:00 | B3  D4  Fs4 A4  | G1      # home, held
6:12 | off             | off

# ---------------- bass: a light boogie off the root ----------------
pattern bass 16 bass
00 | t1:3    .9
04 | t1+12:2 .6
07 | t1:1    .7
08 | t1:3    .85
12 | t1+12:2 .6
14 | t1+7:2  .7

pattern bass_brk 16 bass
00 | t1:12 .65

# ---------------- drums ----------------
pattern drums 16 kick snare hat
lane kick  x... x... x... x.x.
lane snare .... 7... .... 7...
lane hat   5.3. 5.3. 5.3. 5.34

pattern drums_brk 16 snare hat
lane snare .... 4... .... 4...
lane hat   4.2. 3.2. 4.2. 3.2.

# ---------------- the jingle (trumpet) ----------------
pattern lead_a 4x16 lead
1:00 | D5:4  .8
1:04 | B4:2  .7
1:06 | G4:2  .65
1:08 | A4:6  .75
1:14 | B4:2  .6
2:00 | D5:6  .85
2:06 | E5:2  .7
2:08 | D5:8  .75
3:04 | E5:2  .6       # the answer, over Cmaj9 | D6/9
3:06 | D5:2  .6
3:08 | B4:4  .7
3:12 | A4:4  .65
4:00 | A4:12 .7

pattern lead_b 4x16 lead
1:00 | D5:4  .8
1:04 | B4:2  .7
1:06 | G4:2  .65
1:08 | A4:6  .75
1:14 | B4:2  .6
2:00 | D5:6  .85
2:06 | E5:2  .7
2:08 | D5:8  .75
3:00 | E5:4  .75      # the answer climbs
3:04 | G5:4  .85
3:08 | E5:4  .75
3:12 | D5:4  .7
4:00 | B4:8  .7
4:08 | D5:8  .75

# ---------------- bells ----------------
pattern chime 4x16 bell          # the PA chime: the jingle's first two notes
1:00 | D5:8  .9
1:08 | B4:24 .8

pattern arp 16 bell              # chord tones an octave up, eighths
00 | t1+12:2 .5
02 | t2+12:2 .4
04 | t3+12:2 .45
06 | t4+12:2 .4
08 | t3+12:2 .45
10 | t2+12:2 .4
12 | t1+12:2 .45
14 | t2+12:2 .35

pattern chime_out 6x16 bell
5:00 | D5:8  .9
5:08 | B4:24 .8

# ---------------- form ----------------
section intro harm+chime
section a     harm+bass+drums
section b     lead_a+harm+bass+drums
section a2    harm+bass+drums+arp
section brk   harm+bass_brk+drums_brk+arp
section b2    lead_a+harm+bass+drums
section b3    lead_b+harm+bass+drums+arp
section outro harm_out+bass+chime_out

order intro
order a*2
order b*2
order a2*2
order brk*2
order a2*2
order b2*2
order b3*2
order outro
