# driftwood — granular ambient
# 220s generative ambient: the `grains` module processes a slow pad source
# into a continuous granular texture; sparse modal hits; sub-bass bed.
# Generated by humans, mistakes by claude.

# === METRONOME ===
clock = clock { bpm: 50 }
g2  = div { by: 2 }      # 2.4 s  — sparse bell strikes
g16 = div { by: 16 }     # 19.2 s — sparse sine events
clock -> g2.in           # without this the dividers never tick — no strikes
clock -> g16.in

# === GLACIAL LFOs (incommensurate periods) ===
l1 = lfo { freq: 0.01370hz }   # 73 s
l2 = lfo { freq: 0.00719hz }   # 139 s
l3 = lfo { freq: 0.00437hz }   # 229 s
l4 = lfo { freq: 0.00279hz }   # 359 s

# === GENERATIVE PITCH REGISTER ===
q1 = quant { scale: [0, 3, 5, 7, 10] }
t1 = turing { len: 8, prob: 0.12, seed: 53 }
clock -> t1.clock
t1 -> q1.in

# === GRANULAR SOURCE: slow saw pad → grains ===
src_vco = vco { freq: 73.42hz, wave: saw }
src_lp = ladder { cutoff: 1200hz, res: 0.15, drive: 0.3 }
src_vco -> src_lp.in

# Continuous low-density granular texture; LFO A breathes the density.
gr = grains { secs: 4, seed: 17 }
src_lp -> gr.in
8 -> gr.density
l1 -> gr.density : 4

# === SPARSE MODAL BELL (every 2.4 s, bern 0.35) ===
mod = modal { modes: 32, freq: 220hz, damping: 0.75, brightness: 0.60 }
b = bern { prob: 0.35, seed: 7 }
g2 -> b.gate
b -> mod.strike
q1 -> mod.v_oct

# === SUB: D1 sine, slow tremolo ===
sub_osc = vco { freq: 36.71hz, wave: sine }
sub_vca = vca { gain: 0.0 }
sub_osc -> sub_vca.in
0.15 -> sub_vca.gain
l2 -> sub_vca.gain : 0.10

# === VERY SPARSE SINE EVENTS ===
ev_pulse = bern { prob: 0.25, seed: 91 }
ev_env = adsr { attack: 2, decay: 6, sustain: 0.3, release: 8 }
ev_vca = vca { gain: 0.0 }
ev_osc = vco { freq: 220hz, wave: sine }
g16 -> ev_pulse.gate
ev_pulse -> ev_env.gate
ev_env -> ev_vca.gain
ev_osc -> ev_vca.in
q1 -> ev_osc.v_oct

# === MIX: voice bus ===
# Five inputs need five levels — the events (in5) were defaulting to 1.0.
bus = mix { levels: [0.6, 0.6, 0.5, 0.4, 0.4] }
gr.out_l -> bus.in1 : 0.5
gr.out_r -> bus.in2 : 0.5
mod -> bus.in3
sub_vca -> bus.in4
ev_vca -> bus.in5

# === FX: tempo-synced delay + long plate reverb ===
fx = mix { levels: [0.55, 0.55] }
rev = reverb { decay: 0.88, damp: 0.30, mix: 1, predelay: 0.025,
               bandwidth: 0.92, mod_rate: 0.3, mod_depth: 18 }
del = delay { time: 2.4s, feedback: 0.4, mix: 1, tone: 2400, slew: 0.3 }
bus.out_l -> fx.in1
bus.out_r -> fx.in2
fx.out_l -> rev.in_l
fx.out_r -> rev.in_r
fx.out_l -> del.in

# === MASTER ===
master = mix { levels: [1, 1, 0.55, 0.55, 0.5],
               pans: [-1, 1, -1, 1, 0] }
bus.out_l -> master.in1
bus.out_r -> master.in2
rev.out_l -> master.in3
rev.out_r -> master.in4
del.out -> master.in5

# === MASTERING ===
dc = dcblock { cutoff: 15hz }
eq_m = eq { hp_freq: 30, low_freq: 100, low_gain: -0.5,
            mid1_freq: 500, mid1_gain: -0.3, mid1_q: 0.8,
            mid2_freq: 4000, mid2_gain: 0.4, mid2_q: 0.8,
            high_freq: 10000, high_gain: 0.3 }
comp_m = compressor { threshold: -18, ratio: 2.0, knee: 8,
                      attack: 0.05, release: 0.3, makeup: 4.1, mix: 1 }
field = stereo { width: 1.2, balance: 0 }
clip = clipper { mode: soft, threshold: -3, drive: 0.5, mix: 0.5 }
lim = limiter { threshold: -1.0, release: 0.15 }

master.out_l -> dc.in_l
master.out_r -> dc.in_r
dc.out_l -> eq_m.in_l
dc.out_r -> eq_m.in_r
eq_m.out_l -> comp_m.in_l
eq_m.out_r -> comp_m.in_r
comp_m.out_l -> field.in_l
comp_m.out_r -> field.in_r
field.out_l -> clip.in_l
field.out_r -> clip.in_r
clip.out_l -> lim.in_l
clip.out_r -> lim.in_r
lim.out_l -> out.left
lim.out_r -> out.right
-0.2 -> out.level
