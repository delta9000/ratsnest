# groove -- minimal techno sketch using subpatches.
# Kick, FM bass, closed hat, and open hat — euclidean-driven.
#
# Run:  mise run play -- patches/groove.patch

clk = clock { bpm: 124 }

hat_pat  = euclid { steps: 8,  hits: 5, rot: 0 }
open_pat = euclid { steps: 8,  hits: 3, rot: 2 }
bass_pat = euclid { steps: 8, hits: 4, rot: 0 }

clk -> hat_pat.clock
clk -> open_pat.clock
clk -> bass_pat.clock

kick = sub { file: "lib/kick.sub" }
clk -> kick.trig

hat = sub { file: "lib/hat.sub", pitch: 8khz, decay: 0.05s, color: 0.1 }
hat_pat.gate -> hat.trig

open = sub { file: "lib/hat.sub", pitch: 5khz, decay: 0.18s, color: 0.3 }
open_pat.gate -> open.trig

bass = sub { file: "lib/bass.sub", pitch: G2, decay: 0.12s }
bass_pat.gate -> bass.trig

# Bassline: G-minor loop, escape-hatch into fm.v_oct
bass_seq = stepseq { steps: [G2v, A2v, C3v, G2v], gates: [1, 0, 0, 0] }
clk -> bass_seq.clock
bass_seq.cv -> bass.fm.v_oct

m = mix { levels: [0.45, 0.35, 0.28, 0.4] }
kick -> m.in1
hat  -> m.in2
open -> m.in3
bass -> m.in4
m.out_l -> out.in
